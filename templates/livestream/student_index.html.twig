{% extends 'base.html.twig' %}

{% block title %}Live Sessions — LearnWay{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto; padding-bottom: 64px;">
    
    {# ── HERO SECTION ── #}
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px; background: linear-gradient(135deg, #1976d2, #42a5f5); padding: 48px; border-radius: var(--m3-radius-large); color: white; box-shadow: 0 8px 32px rgba(0,0,0,0.1);">
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <h1 style="margin: 0; font-size: 2.5rem; font-weight: 300;">🎥 Join a <span style="font-weight: 600;">Live Session</span></h1>
            <p style="margin: 0; opacity: 0.9; font-size: 1.125rem;">Attend your class livestreams and learn live with your teacher.</p>
            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <div style="background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: var(--m3-radius-full); font-size: 0.875rem; backdrop-filter: blur(8px);">
                    {{ "now"|date("l, F jS") }}
                </div>
            </div>
        </div>
        <div style="font-size: 5rem; opacity: 0.2; transform: rotate(-10deg);">📹</div>
    </div>

    {# ── MAIN CONTENT & SIDEBAR ── #}
    <div style="display: grid; grid-template-columns: 1fr 320px; gap: 40px; align-items: flex-start;">
        
        {# ── LEFT: TABS & SESSIONS ── #}
        <div style="display: flex; flex-direction: column; gap: 24px;">
            
            <!-- Tabs Navigation -->
            <div style="display: flex; gap: 0.5rem; border-bottom: 2px solid var(--m3-outline);">
                <button onclick="switchTab('upcoming')" id="tab-upcoming" style="
                    padding: 12px 16px;
                    border: none;
                    background: none;
                    cursor: pointer;
                    color: var(--m3-primary);
                    font-weight: 600;
                    border-bottom: 3px solid var(--m3-primary);
                    font-size: 0.9375rem;
                    transition: all 0.3s ease;
                    margin-bottom: -2px;
                ">
                    📅 Upcoming
                </button>
                <button onclick="switchTab('live')" id="tab-live" style="
                    padding: 12px 16px;
                    border: none;
                    background: none;
                    cursor: pointer;
                    color: var(--m3-on-surface-variant);
                    font-weight: 600;
                    border-bottom: 3px solid transparent;
                    font-size: 0.9375rem;
                    transition: all 0.3s ease;
                    margin-bottom: -2px;
                ">
                    🔴 Live Now
                </button>
                <button onclick="switchTab('past')" id="tab-past" style="
                    padding: 12px 16px;
                    border: none;
                    background: none;
                    cursor: pointer;
                    color: var(--m3-on-surface-variant);
                    font-weight: 600;
                    border-bottom: 3px solid transparent;
                    font-size: 0.9375rem;
                    transition: all 0.3s ease;
                    margin-bottom: -2px;
                ">
                    ✅ Past
                </button>
            </div>

            {% if livestreams is empty %}
                <div class="m3-card m3-card-outlined" style="text-align: center; padding: 80px; border-style: dashed; border-width: 2px;">
                    <div style="font-size: 5rem; margin-bottom: 24px; filter: grayscale(1); opacity: 0.3;">🎥</div>
                    <h3 style="margin: 0 0 8px 0; font-size: 1.75rem; font-weight: 400; color: var(--m3-on-surface);">No sessions yet</h3>
                    <p style="margin: 0; color: var(--m3-on-surface-variant); font-size: 1.1rem;">Your teacher hasn't scheduled any livestreams yet.</p>
                </div>
            {% else %}
                <!-- UPCOMING TAB -->
                <div id="upcoming-content" style="display: flex; flex-direction: column; gap: 16px;">
                    {% for livestream in livestreams %}
                        {% if livestream.status == 'SCHEDULED' %}
                            <div class="m3-card m3-card-elevated" style="padding: 20px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);" onmouseover="this.style.transform='translateY(-4px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px rgba(0,0,0,0.3), 0 1px 3px 1px rgba(0,0,0,0.15)'">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                    <div style="flex: 1;">
                                        <h3 style="margin: 0 0 4px 0; font-size: 1.125rem; font-weight: 600; color: var(--m3-on-surface);">{{ livestream.title }}</h3>
                                        <p style="margin: 0; font-size: 0.8125rem; color: var(--m3-on-surface-variant);">👨‍🏫 {{ livestream.teacher.firstName }} {{ livestream.teacher.lastName }}</p>
                                    </div>
                                    <span style="background: var(--m3-primary-container); padding: 4px 10px; border-radius: 16px; font-size: 0.7rem; font-weight: 700; color: var(--m3-on-primary-container); text-transform: uppercase; white-space: nowrap;">
                                        Scheduled
                                    </span>
                                </div>
                                <div style="font-size: 0.875rem; color: var(--m3-on-surface-variant); margin-bottom: 12px;">
                                    📚 {{ livestream.classe.name }} • ⏰ {{ livestream.scheduledAt|date('M d, H:i') }}
                                </div>
                                {% if livestream.description %}
                                    <p style="margin: 0 0 12px 0; color: var(--m3-on-surface); line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 0.875rem;">
                                        {{ livestream.description }}
                                    </p>
                                {% endif %}
                                <a href="{{ path('app_livestream_show', {id: livestream.id}) }}" class="m3-button m3-button-filled" style="width: 100%; padding: 10px;">
                                    ✅ Join Session
                                </a>
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>

                <!-- LIVE TAB -->
                <div id="live-content" style="display: none; flex-direction: column; gap: 16px;">
                    {% set hasLive = false %}
                    {% for livestream in livestreams %}
                        {% if livestream.status == 'LIVE' %}
                            {% set hasLive = true %}
                            <div class="m3-card m3-card-elevated" style="padding: 20px; border: 2px solid #d32f2f; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='translateY(0)'">
                                <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 12px; color: #d32f2f; font-weight: 700; font-size: 0.8125rem; text-transform: uppercase;">
                                    <span style="display: inline-block; width: 8px; height: 8px; background: #d32f2f; border-radius: 50%; animation: pulse 1s infinite;"></span>
                                    Live Now
                                </div>
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                    <div style="flex: 1;">
                                        <h3 style="margin: 0 0 4px 0; font-size: 1.125rem; font-weight: 600; color: var(--m3-on-surface);">{{ livestream.title }}</h3>
                                        <p style="margin: 0; font-size: 0.8125rem; color: var(--m3-on-surface-variant);">👨‍🏫 {{ livestream.teacher.firstName }} {{ livestream.teacher.lastName }}</p>
                                    </div>
                                </div>
                                <div style="font-size: 0.875rem; color: var(--m3-on-surface-variant); margin-bottom: 12px;">
                                    📚 {{ livestream.classe.name }}
                                </div>
                                <a href="{{ path('app_livestream_show', {id: livestream.id}) }}" class="m3-button m3-button-filled" style="width: 100%; padding: 10px; background-color: #d32f2f;">
                                    🎥 Join Now
                                </a>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% if not hasLive %}
                        <div class="m3-card m3-card-outlined" style="text-align: center; padding: 60px; border-style: dashed; border-width: 2px;">
                            <div style="font-size: 4rem; margin-bottom: 16px; opacity: 0.3;">🔴</div>
                            <p style="margin: 0; color: var(--m3-on-surface-variant);">No live sessions right now.</p>
                        </div>
                    {% endif %}
                </div>

                <!-- PAST TAB -->
                <div id="past-content" style="display: none; flex-direction: column; gap: 16px;">
                    {% set hasPast = false %}
                    {% for livestream in livestreams %}
                        {% if livestream.status == 'ENDED' %}
                            {% set hasPast = true %}
                            <div class="m3-card m3-card-elevated" style="padding: 20px; opacity: 0.8;">
                                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 12px;">
                                    <div style="flex: 1;">
                                        <h3 style="margin: 0 0 4px 0; font-size: 1.125rem; font-weight: 600; color: var(--m3-on-surface);">{{ livestream.title }}</h3>
                                        <p style="margin: 0; font-size: 0.8125rem; color: var(--m3-on-surface-variant);">👨‍🏫 {{ livestream.teacher.firstName }} {{ livestream.teacher.lastName }}</p>
                                    </div>
                                    <span style="background: var(--m3-surface-container); padding: 4px 10px; border-radius: 16px; font-size: 0.7rem; font-weight: 700; color: var(--m3-on-surface-variant); text-transform: uppercase;">
                                        Ended
                                    </span>
                                </div>
                                <div style="font-size: 0.875rem; color: var(--m3-on-surface-variant); margin-bottom: 12px;">
                                    📅 {{ livestream.scheduledAt|date('M d, Y') }}
                                    {% if livestream.endedAt %}
                                        • ⏱️
                                        {% set duration = livestream.endedAt.diff(livestream.startedAt) %}
                                        {{ duration.h }}h {{ duration.i }}m
                                    {% endif %}
                                </div>
                                <button disabled class="m3-button m3-button-outlined" style="width: 100%;">
                                    ✅ Session Ended
                                </button>
                            </div>
                        {% endif %}
                    {% endfor %}
                    {% if not hasPast %}
                        <div class="m3-card m3-card-outlined" style="text-align: center; padding: 60px; border-style: dashed; border-width: 2px;">
                            <div style="font-size: 4rem; margin-bottom: 16px; opacity: 0.3;">✅</div>
                            <p style="margin: 0; color: var(--m3-on-surface-variant);">No past sessions yet.</p>
                        </div>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        {# ── RIGHT: SIDEBAR ── #}
        <aside style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Summary -->
            <div class="m3-card m3-card-filled" style="padding: 20px; background: var(--m3-surface-container-high);">
                <h3 style="margin: 0 0 14px 0; font-size: 1rem; font-weight: 600;">Summary</h3>
                <div style="display: flex; flex-direction: column; gap: 10px;">
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--m3-on-surface-variant); font-size: 0.875rem;">Total Sessions</span>
                        <span style="font-weight: 700; color: var(--m3-primary); font-size: 1.25rem;">{{ livestreams|length }}</span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--m3-on-surface-variant); font-size: 0.875rem;">Live Now</span>
                        <span style="font-weight: 700; color: #d32f2f; font-size: 1.25rem;">
                            {% set liveCount = livestreams|filter(s => s.status == 'LIVE')|length %}
                            {{ liveCount }}
                        </span>
                    </div>
                    <div style="display: flex; justify-content: space-between; align-items: center;">
                        <span style="color: var(--m3-on-surface-variant); font-size: 0.875rem;">Upcoming</span>
                        <span style="font-weight: 700; color: var(--m3-primary); font-size: 1.25rem;">
                            {% set upcomingCount = livestreams|filter(s => s.status == 'SCHEDULED')|length %}
                            {{ upcomingCount }}
                        </span>
                    </div>
                </div>
            </div>

            <!-- Upcoming Sessions -->
            <div class="m3-card m3-card-outlined" style="padding: 20px;">
                <h3 style="margin: 0 0 12px 0; font-size: 1rem; font-weight: 600;">Next Session</h3>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    {% set nextSession = livestreams|filter(s => s.status == 'SCHEDULED')|first %}
                    {% if nextSession %}
                        <div>
                            <p style="margin: 0 0 4px 0; font-size: 0.875rem; font-weight: 600; color: var(--m3-on-surface);">{{ nextSession.title }}</p>
                            <p style="margin: 0; font-size: 0.8125rem; color: var(--m3-on-surface-variant);">
                                📅 {{ nextSession.scheduledAt|date('M d, H:i') }}
                            </p>
                        </div>
                    {% else %}
                        <p style="margin: 0; font-size: 0.875rem; color: var(--m3-on-surface-variant);">No upcoming sessions scheduled.</p>
                    {% endif %}
                </div>
            </div>

            <!-- Tips -->
            <div class="m3-card m3-card-outlined" style="padding: 20px; background: var(--m3-primary-container); border-color: var(--m3-primary);">
                <h4 style="margin: 0 0 8px 0; color: var(--m3-on-primary-container); font-weight: 600; font-size: 0.9375rem;">💡 Tip</h4>
                <p style="margin: 0; font-size: 0.8125rem; color: var(--m3-on-primary-container); line-height: 1.5;">
                    Join on time to get the most out of your learning experience!
                </p>
            </div>
        </aside>
    </div>
</div>

<style>
@keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}
</style>

<script>
function switchTab(tab) {
    document.getElementById('upcoming-content').style.display = tab === 'upcoming' ? 'flex' : 'none';
    document.getElementById('live-content').style.display = tab === 'live' ? 'flex' : 'none';
    document.getElementById('past-content').style.display = tab === 'past' ? 'flex' : 'none';

    // Update tab styling
    document.getElementById('tab-upcoming').style.color = tab === 'upcoming' ? 'var(--m3-primary)' : 'var(--m3-on-surface-variant)';
    document.getElementById('tab-upcoming').style.borderBottomColor = tab === 'upcoming' ? 'var(--m3-primary)' : 'transparent';

    document.getElementById('tab-live').style.color = tab === 'live' ? '#d32f2f' : 'var(--m3-on-surface-variant)';
    document.getElementById('tab-live').style.borderBottomColor = tab === 'live' ? '#d32f2f' : 'transparent';

    document.getElementById('tab-past').style.color = tab === 'past' ? 'var(--m3-primary)' : 'var(--m3-on-surface-variant)';
    document.getElementById('tab-past').style.borderBottomColor = tab === 'past' ? 'var(--m3-primary)' : 'transparent';
}
</script>
{% endblock %}
