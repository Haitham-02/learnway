{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    <div style="margin-bottom: 40px;">
        <h1 style="margin: 0; font-size: 2.5rem; font-weight: 300; color: var(--m3-on-surface);">Welcome, {{ app.user.firstName }}!</h1>
        <p style="margin: 8px 0 0; color: var(--m3-on-surface-variant); font-size: 1.1rem;">Here's what's happening across the platform.</p>
    </div>

    {% if is_granted('ROLE_ADMIN') and stats is defined %}
    <div style="margin-bottom: 24px; font-size: 1.25rem; font-weight: 500; color: var(--m3-primary); letter-spacing: 0.1px;">Platform Overview</div>
    
    <div style="display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); margin-bottom: 48px;">
        
        {# Users Card #}
        <div class="m3-card m3-card-elevated" style="padding: 24px; border-left: 4px solid var(--m3-primary);">
            <div style="font-size: 0.875rem; font-weight: 500; color: var(--m3-on-surface-variant); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Total Users</div>
            <div style="font-size: 3rem; font-weight: 300; color: var(--m3-primary);">{{ stats.users }}</div>
            <div style="margin-top: 16px;">
                <a href="{{ path('admin_users_index') }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 16px;">Manage</a>
            </div>
        </div>

        {# Classes Card #}
        <div class="m3-card m3-card-elevated" style="padding: 24px; border-left: 4px solid var(--m3-secondary);">
            <div style="font-size: 0.875rem; font-weight: 500; color: var(--m3-on-surface-variant); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Classes</div>
            <div style="font-size: 3rem; font-weight: 300; color: var(--m3-secondary);">{{ stats.classes }}</div>
            <div style="margin-top: 16px;">
                <a href="{{ path('admin_classes_index') }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 16px;">View</a>
            </div>
        </div>

        {# Subjects Card #}
        <div class="m3-card m3-card-elevated" style="padding: 24px; border-left: 4px solid var(--m3-primary-container);">
            <div style="font-size: 0.875rem; font-weight: 500; color: var(--m3-on-surface-variant); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Subjects</div>
            <div style="font-size: 3rem; font-weight: 300; color: var(--m3-primary-container);">{{ stats.subjects }}</div>
            <div style="margin-top: 16px;">
                <a href="{{ path('admin_subjects_index') }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 16px;">Explore</a>
            </div>
        </div>

        {# Enrollments Card #}
        <div class="m3-card m3-card-elevated" style="padding: 24px; border-left: 4px solid var(--m3-secondary-container);">
            <div style="font-size: 0.875rem; font-weight: 500; color: var(--m3-on-surface-variant); margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px;">Enrollments</div>
            <div style="font-size: 3rem; font-weight: 300; color: var(--m3-secondary-container);">{{ stats.enrollments }}</div>
            <div style="margin-top: 16px;">
                <a href="{{ path('admin_student_enrollments_index') }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 16px;">Review</a>
            </div>
        </div>

    </div>

    {# Chart Section #}
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 32px; margin-bottom: 48px;">
        {% if chart is defined %}
        <div style="display: flex; flex-direction: column;">
            <div style="margin-bottom: 24px; font-size: 1.25rem; font-weight: 500; color: var(--m3-primary); letter-spacing: 0.1px;">User Distribution</div>
            <div class="m3-card m3-card-elevated" style="padding: 32px; flex-grow: 1; min-height: 300px;">
                {{ render_chart(chart) }}
            </div>
        </div>
        {% endif %}

        {% if chart2 is defined %}
        <div style="display: flex; flex-direction: column;">
            <div style="margin-bottom: 24px; font-size: 1.25rem; font-weight: 500; color: var(--m3-primary); letter-spacing: 0.1px;">Engagement Overview</div>
            <div class="m3-card m3-card-elevated" style="padding: 32px; flex-grow: 1; min-height: 300px;">
                {{ render_chart(chart2) }}
            </div>
        </div>
        {% endif %}
    </div>

    {% endif %}
</div>
{% endblock %}
