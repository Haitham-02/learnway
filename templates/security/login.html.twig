{% extends 'base.html.twig' %}

{% block title %}Sign In — LearnWay{% endblock %}

{% block body %}
<div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background-color: var(--m3-surface-container-low); font-family: 'Roboto', sans-serif;">
    <div class="m3-card m3-card-elevated" style="width: 100%; max-width: 440px; padding: 48px; background: #ffffff; border-radius: 28px; box-shadow: 0 12px 48px rgba(0,0,0,0.08);">
        
        <div style="text-align: center; margin-bottom: 40px;">
            <div style="width: 64px; height: 64px; background: #224870; color: #ffffff; border-radius: 16px; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 24px; box-shadow: 0 8px 16px rgba(34, 72, 112, 0.2);">
                🎓
            </div>
            <h1 style="margin: 0; font-size: 1.75rem; font-weight: 500; color: #122c34;">Welcome to LearnWay</h1>
            <p style="margin: 8px 0 0; color: #4b636e; font-size: 0.9375rem;">Sign in to manage your academy</p>
        </div>

        {% if error %}
            <div style="background-color: #ffebee; color: #c62828; padding: 16px; border-radius: 12px; margin-bottom: 32px; font-size: 0.875rem; border: 1px solid rgba(198, 40, 40, 0.1); display: flex; align-items: flex-start; gap: 12px;">
                <span style="font-size: 1.1rem; line-height: 1;">⚠️</span>
                <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
            </div>
        {% endif %}

        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label for="email" style="font-size: 0.75rem; font-weight: 600; color: #224870; letter-spacing: 0.5px;">EMAIL ADDRESS</label>
                <input type="email" id="email" name="email" value="{{ last_username }}" required autofocus 
                       style="width: 100%; height: 56px; padding: 0 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 1rem; color: #1e293b; outline: none; transition: all 0.2s;"
                       onfocus="this.style.borderColor='#224870'; this.style.boxShadow='0 0 0 3px rgba(34, 72, 112, 0.1)'; this.style.background='#ffffff'"
                       onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'; this.style.background='#f8fafc'"
                       placeholder="haitham@learnway.com">
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <label for="password" style="font-size: 0.75rem; font-weight: 600; color: #224870; letter-spacing: 0.5px;">PASSWORD</label>
                    <a href="#" style="font-size: 0.75rem; color: #224870; text-decoration: none; font-weight: 500;">Forgot?</a>
                </div>
                <input type="password" id="password" name="password" required 
                       style="width: 100%; height: 56px; padding: 0 16px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; font-size: 1rem; color: #1e293b; outline: none; transition: all 0.2s;"
                       onfocus="this.style.borderColor='#224870'; this.style.boxShadow='0 0 0 3px rgba(34, 72, 112, 0.1)'; this.style.background='#ffffff'"
                       onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'; this.style.background='#f8fafc'"
                       placeholder="••••••••">
            </div>

            <button type="submit" class="m3-button m3-button-filled" 
                    style="width: 100%; height: 56px; font-size: 1rem; border-radius: 12px; background: #224870; color: #ffffff; border: none; font-weight: 600; cursor: pointer; transition: all 0.2s; margin-top: 8px; box-shadow: 0 4px 12px rgba(34, 72, 112, 0.25);"
                    onmouseover="this.style.background='#2a4494'; this.style.transform='translateY(-1px)'"
                    onmouseout="this.style.background='#224870'; this.style.transform='translateY(0)'">
                Sign In
            </button>
        </form>
        
        <div style="margin-top: 40px; text-align: center; border-top: 1px solid #f1f5f9; padding-top: 24px;">
            <p style="font-size: 0.875rem; color: #64748b;">Don't have an account? <a href="#" style="color: #224870; text-decoration: none; font-weight: 600;">Contact Administrator</a></p>
        </div>
    </div>
</div>
{% endblock %}
