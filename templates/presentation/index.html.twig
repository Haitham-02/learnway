<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>LearnWay — The Intelligent Future of Education</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🚀</text></svg>">
    
    {# Fonts & Icons #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Outfit:wght@400;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0" />
    
    <link rel="stylesheet" href="{{ asset('css/presentation.css') }}">
    
    {{ importmap('app') }}
</head>
<body class="presentation-mode">

    <div class="presentation-container" data-controller="presentation">
        
        {# ── NAVIGATION DOTS ── #}
        <div class="nav-dots">
            {% for i in 0..11 %}
                <div class="dot" data-presentation-target="dot" data-index="{{ i }}" data-action="click->presentation#goTo"></div>
            {% endfor %}
        </div>

        {# ── SECTION 1: THE TEAM (Alphax) ── #}
        <section data-presentation-target="section" style="padding-top: 40px;">
            <div class="slide-number">01</div>
            <div class="glow" style="top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; opacity: 0.1;"></div>
            <div class="reveal">
                <div style="text-align: center; margin-bottom: 60px;">
                    <img src="{{ asset('/images/Alphax_logo.png') }}" style="height: 180px; width: auto; filter: drop-shadow(0 0 25px rgba(59, 130, 246, 0.4));">
                    <div style="margin-top: 16px;">
                        <span style="color: #3b82f6; font-weight: 800; text-transform: uppercase; letter-spacing: 5px; font-size: 1.6rem; opacity: 1; text-shadow: 0 0 20px rgba(59, 130, 246, 0.6);">Presenting the team</span>
                    </div>
                </div>
                
                <div class="team-grid" style="grid-template-columns: repeat(4, 1fr); gap: 24px; align-items: stretch;">
                    {% set accents = ['linear-gradient(90deg, #224870, #4ea5d9)', 'linear-gradient(90deg, #4ea5d9, #44cfcb)', 'linear-gradient(90deg, #44cfcb, #224870)', 'linear-gradient(90deg, #122c34, #4ea5d9)'] %}
                    {% for member in team %}
                        <div class="team-card-premium">
                            <div class="team-accent-line" style="background: {{ accents[loop.index0] }};"></div>
                            <div class="team-image-box">
                                <img src="{{ asset(member.image) }}">
                            </div>
                            <div class="team-info-box">
                                <div style="font-size: 1.5rem; font-weight: 800; color: #f9fafb; margin-bottom: 8px;">{{ member.name }}</div>
                                <div style="font-size: 0.85rem; font-weight: 800; color: #7dd3fc; letter-spacing: 0.08em; margin-bottom: 16px; text-transform: uppercase;">{{ member.role }}</div>
                                <p style="font-size: 0.95rem; color: rgba(255,255,255,0.7); line-height: 1.6; margin: 0;">{{ member.description }}</p>
                            </div>
                            <div class="tech-tags">
                                {% for tech in member.tech_stack %}
                                    <span class="tech-tag">{{ tech }}</span>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>

        {# ── SECTION 2: INTRODUCTION (LearnWay) ── #}
        <section data-presentation-target="section">
            <div class="slide-number">02</div>
            <div class="glow" style="top: -100px; left: -100px;"></div>
            <div class="reveal" style="display: flex; align-items: center; gap: 80px;">
                
                {# LEFT CONTENT #}
                <div style="flex: 1;">
                    <div style="display: inline-flex; align-items: center; gap: 8px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.25); border-radius: 50px; padding: 10px 24px; margin-bottom: 3rem;">
                        <span style="width: 10px; height: 10px; border-radius: 50%; background: #44cfcb; display: inline-block;"></span>
                        <span style="font-size: 0.9rem; font-weight: 800; color: var(--p-primary); letter-spacing: 0.1em;">ALL-IN-ONE ACADEMY PLATFORM</span>
                    </div>

                    <h1 style="font-size: 4rem;">LearnWay: The Intelligent Future of Education</h1>
                    <p class="lead" style="margin-top: 24px;">Unlock your academy potential with a premium, AI-powered ecosystem that redefines the educational experience. By integrating RAG-based assistance, real-time engagement monitoring, and seamless administration, bridging the gap between innovation and academic excellence.</p>
                </div>

                {# RIGHT CONTENT (DASHBOARD MOCKUP) #}
                <div style="flex: 1.4; display: flex; align-items: center; justify-content: center;">
                    <div class="hover-float" style="width: 80%; background: #0d1b2a; border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 20px; overflow: hidden; box-shadow: 0 50px 120px rgba(0,0,0,0.7);">
                        <!-- Window bar -->
                        <div style="background: linear-gradient(135deg, #0f2338, #162d4a); padding: 12px 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); display: flex; align-items: center; gap: 8px;">
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #ff5f57;"></span>
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #febc2e;"></span>
                            <span style="width: 10px; height: 10px; border-radius: 50%; background: #28c840;"></span>
                            <span style="flex: 1; background: rgba(255,255,255,0.05); border-radius: 6px; height: 20px; margin-left: 10px; display: flex; align-items: center; padding: 0 10px;">
                                <span style="font-size: 10px; color: rgba(255,255,255,0.3);">learnway.academy / admin / dashboard</span>
                            </span>
                        </div>

                        <!-- Dashboard body -->
                        <div style="display: flex; height: 580px;">
                            <!-- Sidebar -->
                            <div style="width: 60px; background: rgba(15,35,56,0.8); border-right: 1px solid rgba(255,255,255,0.05); display: flex; flex-direction: column; align-items: center; gap: 16px; padding: 16px 0;">
                                <img src="{{ asset('images/LearnWay logo.png') }}" style="width: 24px; height: 24px; margin-bottom: 8px;">
                                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center; font-size: 14px;">🏠</div>
                                <div style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; opacity: 0.4;">👥</div>
                                <div style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; opacity: 0.4;">📅</div>
                                <div style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 14px; opacity: 0.4;">💬</div>
                            </div>

                            <!-- Main content -->
                            <div style="flex: 1; padding: 16px; display: flex; flex-direction: column; gap: 12px; overflow: hidden;">
                                <div style="display: flex; justify-content: space-between; align-items: center;">
                                    <div style="font-size: 14px; font-weight: 700;">Good morning, Admin 👋</div>
                                    <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 20px; padding: 2px 8px; font-size: 9px; color: #10b981;">● SYSTEM ONLINE</div>
                                </div>

                                <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
                                    <div class="glass-card" style="padding: 10px; text-align: center; border-radius: 12px;">
                                        <div style="font-size: 1.25rem; font-weight: 800; color: #44cfcb;">{{ stats.total_users }}</div>
                                        <div style="font-size: 9px; color: var(--p-muted);">Students</div>
                                    </div>
                                    <div class="glass-card" style="padding: 10px; text-align: center; border-radius: 12px;">
                                        <div style="font-size: 1.25rem; font-weight: 800; color: var(--p-primary);">{{ stats.livestreams }}</div>
                                        <div style="font-size: 9px; color: var(--p-muted);">Streams</div>
                                    </div>
                                    <div class="glass-card" style="padding: 10px; text-align: center; border-radius: 12px;">
                                        <div style="font-size: 1.25rem; font-weight: 800; color: #7dd3fc;">{{ stats.forum_posts }}</div>
                                        <div style="font-size: 9px; color: var(--p-muted);">Posts</div>
                                    </div>
                                </div>

                                <!-- Learning Chart -->
                                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px; height: 120px;">
                                    <div style="font-size: 10px; font-weight: 600; color: var(--p-muted); margin-bottom: 8px;">LEARNING ENGAGEMENT</div>
                                    <div style="height: 60px; display: flex; align-items: flex-end; gap: 4px;">
                                        <div style="flex: 1; height: 40%; background: #3b82f6; opacity: 0.3; border-radius: 2px;"></div>
                                        <div style="flex: 1; height: 65%; background: #3b82f6; opacity: 0.5; border-radius: 2px;"></div>
                                        <div style="flex: 1; height: 50%; background: #3b82f6; opacity: 0.4; border-radius: 2px;"></div>
                                        <div style="flex: 1; height: 90%; background: #3b82f6; border-radius: 2px; box-shadow: 0 0 10px #3b82f6;"></div>
                                        <div style="flex: 1; height: 75%; background: #3b82f6; opacity: 0.7; border-radius: 2px;"></div>
                                        <div style="flex: 1; height: 60%; background: #3b82f6; opacity: 0.5; border-radius: 2px;"></div>
                                    </div>
                                </div>

                                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); border-radius: 12px; padding: 12px;">
                                    <div style="font-size: 10px; font-weight: 600; color: var(--p-muted); margin-bottom: 8px;">RECENT ACTIVITY</div>
                                    <div style="display: flex; flex-direction: column; gap: 6px;">
                                        <div style="font-size: 11px; display: flex; align-items: center; gap: 8px;">
                                            <span style="color: #44cfcb;">●</span> New student enrolled in Class 10-B
                                        </div>
                                        <div style="font-size: 11px; display: flex; align-items: center; gap: 8px;">
                                            <span style="color: #ef4444;">●</span> Forum post flagged for review
                                        </div>
                                    </div>
                                </div>

                                <!-- Expanded Copilot Card -->
                                <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(139, 92, 246, 0.15)); border: 1px solid rgba(59, 130, 246, 0.3); border-radius: 12px; padding: 16px; flex: 1; display: flex; flex-direction: column; gap: 10px;">
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <img src="{{ asset('images/LearnWay logo.png') }}" style="width: 20px; height: 20px;">
                                        <span style="font-size: 11px; font-weight: 700; color: #7dd3fc; letter-spacing: 1px;">AI COPILOT INSIGHT</span>
                                    </div>
                                    <div style="font-size: 11px; color: rgba(255,255,255,0.8); line-height: 1.5;">
                                        "Overall engagement is up 12% today. I recommend reviewing the latest Forum questions in <b>Software Security</b>."
                                    </div>
                                    <div style="display: flex; gap: 6px; margin-top: auto;">
                                        <div style="padding: 4px 8px; background: rgba(59, 130, 246, 0.2); border-radius: 4px; font-size: 9px; color: #7dd3fc;">Analyze Mood</div>
                                        <div style="padding: 4px 8px; background: rgba(255, 255, 255, 0.05); border-radius: 4px; font-size: 9px; color: white;">Dismiss</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ── SECTION 3: THE PROBLEM ── #}
        <section data-presentation-target="section">
            <div class="slide-number">03</div>
            <div class="glow" style="bottom: 0; right: 0; background: radial-gradient(circle, rgba(239, 68, 68, 0.05) 0%, transparent 70%);"></div>
            <div class="reveal">
                <div style="text-align: center; margin-bottom: 64px;">
                    <div style="margin-bottom: 12px;">
                        <span style="color: #ef4444; font-size: 5.5rem; font-weight: 900; letter-spacing: -3px; text-transform: uppercase; opacity: 1;">CORE PROBLEMS</span>
                    </div>
                    <span style="color: #ef4444; font-weight: 700; text-transform: uppercase; letter-spacing: 5px; font-size: 1.2rem; opacity: 0.8;">The Educational Crisis</span>
                </div>

                <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;">
                    <!-- Problem 1 -->
                    <div class="glass-card" style="border-top: 4px solid #ef4444; position: relative; overflow: hidden; min-height: 480px; display: flex; flex-direction: column; justify-content: flex-start; padding: 40px;">
                        <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; font-weight: 900; color: rgba(239, 68, 68, 0.03); z-index: 0;">01</div>
                        <div style="width: 64px; height: 64px; background: rgba(239, 68, 68, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                            <span class="material-symbols-rounded" style="font-size: 32px; color: #ef4444;">visibility_off</span>
                        </div>
                        <h3 style="font-size: 1.75rem; margin-bottom: 20px; color: #f9fafb; font-weight: 800;">The Engagement Void</h3>
                        <p style="color: var(--p-muted); line-height: 1.7; font-size: 1.25rem;">Traditional platforms suffer from 70% student disengagement. Modern LMS solutions act as static repositories rather than interactive environments.</p>
                    </div>

                    <!-- Problem 2 -->
                    <div class="glass-card" style="border-top: 4px solid #f59e0b; position: relative; overflow: hidden; min-height: 480px; display: flex; flex-direction: column; justify-content: flex-start; padding: 40px;">
                        <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; font-weight: 900; color: rgba(245, 158, 11, 0.03); z-index: 0;">02</div>
                        <div style="width: 64px; height: 64px; background: rgba(245, 158, 11, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                            <span class="material-symbols-rounded" style="font-size: 32px; color: #f59e0b;">hub</span>
                        </div>
                        <h3 style="font-size: 1.75rem; margin-bottom: 20px; color: #f9fafb; font-weight: 800;">The Silo Effect</h3>
                        <p style="color: var(--p-muted); line-height: 1.7; font-size: 1.25rem;">Fragmented data across disconnected tools. Administrators lack real-time visibility, leading to delayed academic interventions and systemic inefficiencies.</p>
                    </div>

                    <!-- Problem 3 -->
                    <div class="glass-card" style="border-top: 4px solid #3b82f6; position: relative; overflow: hidden; min-height: 480px; display: flex; flex-direction: column; justify-content: flex-start; padding: 40px;">
                        <div style="position: absolute; top: -20px; right: -20px; font-size: 8rem; font-weight: 900; color: rgba(59, 130, 246, 0.03); z-index: 0;">03</div>
                        <div style="width: 64px; height: 64px; background: rgba(59, 130, 246, 0.1); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin-bottom: 24px;">
                            <span class="material-symbols-rounded" style="font-size: 32px; color: #3b82f6;">psychology</span>
                        </div>
                        <h3 style="font-size: 1.75rem; margin-bottom: 20px; color: #f9fafb; font-weight: 800;">The Generic Blueprint</h3>
                        <p style="color: var(--p-muted); line-height: 1.7; font-size: 1.25rem;">One-size-fits-all education. Current systems fail to adapt to individual student needs, ignoring the power of AI-driven personalization and contextual support.</p>
                    </div>
                </div>
            </div>
        </section>

        {# ── SECTION 4: TARGET MARKET ── #}
        <section data-presentation-target="section">
            <div class="slide-number">04</div>
            <div class="glow" style="top: 0; left: 0; background: radial-gradient(circle, rgba(59, 130, 246, 0.05) 0%, transparent 70%);"></div>
            <div class="reveal">
                <div style="text-align: center; margin-bottom: 64px;">
                    <div style="margin-bottom: 12px;">
                        <span style="color: var(--p-primary); font-size: 5.5rem; font-weight: 900; letter-spacing: -3px; text-transform: uppercase; opacity: 1;">MARKET REACH</span>
                    </div>
                    <span style="color: var(--p-primary); font-weight: 700; text-transform: uppercase; letter-spacing: 5px; font-size: 1.2rem; opacity: 0.8;">Target Audience & Market</span>
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">
                    <!-- Column 1: Audience -->
                    <div class="glass-card" style="border-left: 6px solid var(--p-primary); padding: 56px; min-height: 500px; display: flex; flex-direction: column; justify-content: center;">
                        <h3 style="font-size: 2.5rem; margin-bottom: 40px; color: var(--p-primary); font-weight: 800;">The User Ecosystem</h3>
                        <div style="display: flex; flex-direction: column; gap: 32px;">
                            <div style="display: flex; gap: 24px; align-items: center;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(59, 130, 246, 0.1); color: var(--p-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <span class="material-symbols-rounded" style="font-size: 32px;">school</span>
                                </div>
                                <div>
                                    <h4 style="font-size: 1.5rem; color: #f9fafb;">Academic Institutions</h4>
                                    <p style="color: var(--p-muted); font-size: 1.15rem; line-height: 1.6;">Primary schools, high schools, and private academies seeking a unified digital core.</p>
                                </div>
                            </div>
                            <div style="display: flex; gap: 24px; align-items: center;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(59, 130, 246, 0.1); color: var(--p-primary); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <span class="material-symbols-rounded" style="font-size: 32px;">account_balance</span>
                                </div>
                                <div>
                                    <h4 style="font-size: 1.5rem; color: #f9fafb;">Higher Education</h4>
                                    <p style="color: var(--p-muted); font-size: 1.15rem; line-height: 1.6;">Universities and colleges looking to modernize student engagement with AI insights.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Column 2: Market -->
                    <div class="glass-card" style="border-left: 6px solid #10b981; padding: 56px; min-height: 500px; display: flex; flex-direction: column; justify-content: center;">
                        <h3 style="font-size: 2.5rem; margin-bottom: 40px; color: #10b981; font-weight: 800;">The Growth Sectors</h3>
                        <div style="display: flex; flex-direction: column; gap: 32px;">
                            <div style="display: flex; gap: 24px; align-items: center;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(16, 185, 129, 0.1); color: #10b981; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <span class="material-symbols-rounded" style="font-size: 32px;">model_training</span>
                                </div>
                                <div>
                                    <h4 style="font-size: 1.5rem; color: #f9fafb;">Training Centers</h4>
                                    <p style="color: var(--p-muted); font-size: 1.15rem; line-height: 1.6;">Vocational schools and professional certification centers requiring robust management.</p>
                                </div>
                            </div>
                            <div style="display: flex; gap: 24px; align-items: center;">
                                <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(16, 185, 129, 0.1); color: #10b981; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                    <span class="material-symbols-rounded" style="font-size: 32px;">workspace_premium</span>
                                </div>
                                <div>
                                    <h4 style="font-size: 1.5rem; color: #f9fafb;">Modern Educators</h4>
                                    <p style="color: var(--p-muted); font-size: 1.15rem; line-height: 1.6;">Independent teachers and tutors scaling their business with intelligent virtual tools.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        {# ── SECTION 5: COMPETITOR SPOTLIGHT ── #}
        <section data-presentation-target="section">
            <div class="slide-number">05</div>
            <div class="glow" style="top: 50%; left: 50%; transform: translate(-50%, -50%); width: 80%; opacity: 0.1;"></div>
            <div class="reveal">
                <div style="text-align: center; margin-bottom: 60px;">
                    <span style="color: var(--p-muted); font-weight: 700; text-transform: uppercase; letter-spacing: 5px; font-size: 1.2rem; opacity: 0.8;">Competitive Analysis</span>
                    <h2 style="margin-top: 16px; font-size: 3.5rem; font-weight: 800; color: var(--p-primary);">The Industry Benchmark</h2>
                </div>

                <div style="display: flex; align-items: center; gap: 80px; max-width: 1200px; margin: 0 auto;">
                    <div style="flex: 1; text-align: center;">
                        <div class="glass-card" style="padding: 60px; display: inline-block; border-color: rgba(255,255,255,0.1);">
                            <img src="{{ asset('images/blackboard logo.png') }}" style="height: 120px; width: auto; filter: drop-shadow(0 0 20px rgba(255,255,255,0.1));">
                        </div>
                        <div style="margin-top: 32px; font-size: 1.8rem; font-weight: 800; color: #94a3b8;">Blackboard Learn</div>
                    </div>
                    
                    <div style="flex: 1.2;">
                        <p style="font-size: 1.2rem; color: var(--p-muted); line-height: 1.8; margin-bottom: 40px;">
                            Blackboard is a widely adopted Learning Management System (LMS) used by universities and schools worldwide as a primary digital core for hybrid learning.
                        </p>
                        <div style="display: grid; grid-template-columns: 1fr; gap: 20px;">
                            <div style="display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,0.03); padding: 16px 24px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <span class="material-symbols-rounded" style="color: #94a3b8;">check_circle</span>
                                <span style="color: white; font-weight: 600;">Online Course Management</span>
                            </div>
                            <div style="display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,0.03); padding: 16px 24px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <span class="material-symbols-rounded" style="color: #94a3b8;">check_circle</span>
                                <span style="color: white; font-weight: 600;">Virtual Classrooms & Communication</span>
                            </div>
                            <div style="display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,0.03); padding: 16px 24px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <span class="material-symbols-rounded" style="color: #94a3b8;">check_circle</span>
                                <span style="color: white; font-weight: 600;">Assignment & Quiz Infrastructure</span>
                            </div>
                            <div style="display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,0.03); padding: 16px 24px; border-radius: 12px; border: 1px solid rgba(255,255,255,0.05);">
                                <span class="material-symbols-rounded" style="color: #94a3b8;">check_circle</span>
                                <span style="color: white; font-weight: 600;">Student Progress Tracking</span>
                            </div>
                        </div>
                    </div>
                </div>
