{% extends 'base.html.twig' %}

{% block title %}Notifications{% endblock %}

{% block body %}
    <div style="max-width: 860px; margin: 0 auto;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
            <h1 style="margin:0; color:var(--m3-on-surface);">All Notifications</h1>
            <button type="button" class="m3-button m3-button-outlined" onclick="markAllNotificationsRead();">
                Mark all as read
            </button>
        </div>

        <div style="display:flex; flex-direction:column; gap:8px;">
            {% for notification in notifications %}
                <div
                    class="notification-item {{ notification.isRead ? '' : 'unread' }}"
                    onclick='markAsRead(this, {{ notification.id }}, {{ notification.link|default('')|json_encode|raw }})'
                >
                    <div class="notification-content">
                        <div class="notification-title">{{ notification.title }}</div>
                        <div class="notification-message">{{ notification.message }}</div>
                        <div class="notification-time">{{ notification.createdAt|date('M d, H:i') }}</div>
                    </div>
                    {% if not notification.isRead %}
                        <div class="unread-dot"></div>
                    {% endif %}
                </div>
            {% else %}
                <div class="no-notifications">
                    <span class="material-symbols-rounded">notifications_off</span>
                    <p>No notifications yet</p>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
