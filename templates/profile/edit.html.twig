{% extends 'base.html.twig' %}

{% block title %}Edit Profile — LearnWay{% endblock %}

{% block body %}
<div style="max-width: 800px; margin: 0 auto; padding-bottom: 64px;">
    
    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 40px;">
        <h1 style="margin: 0; font-size: 2.25rem; font-weight: 300; color: var(--m3-on-surface);">Edit <span style="font-weight: 700;">Profile</span></h1>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: 12px; margin-bottom: 32px; border: 1px solid var(--m3-error);">
            <ul style="margin: 0; padding-left: 24px;">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: 12px; margin-bottom: 32px; border: 1px solid var(--m3-primary);">
            {{ message }}
        </div>
    {% endfor %}

    <div class="m3-card m3-card-elevated" style="padding: 40px; border-radius: 24px;">
        <form method="post" enctype="multipart/form-data" style="display: flex; flex-direction: column; gap: 32px;">
            
            <div style="display: flex; flex-direction: column; align-items: center; gap: 16px; padding-bottom: 32px; border-bottom: 1px solid var(--m3-outline-variant);">
                <div style="position: relative; width: 120px; height: 120px;">
                    {% if user.profile_picture %}
                        <img src="{{ asset('uploads/profiles/' ~ user.profile_picture) }}" alt="Profile" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover; border: 4px solid var(--m3-primary-container);">
                    {% else %}
                        <div style="width: 100%; height: 100%; border-radius: 50%; background: var(--m3-primary-container); color: var(--m3-on-primary-container); display: flex; align-items: center; justify-content: center; font-size: 3rem; font-weight: 700;">
                            {{ user.firstName|first|upper }}
                        </div>
                    {% endif %}
                    <label for="profile_picture" style="position: absolute; bottom: 0; right: 0; width: 40px; height: 40px; background: var(--m3-primary); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; border: 3px solid white; font-size: 1.25rem;">
                        📷
                    </label>
                    <input type="file" name="profile_picture" id="profile_picture" accept="image/*" style="display: none;">
                </div>
                <div style="text-align: center;">
                    <h2 style="margin: 0; font-size: 1.5rem; color: var(--m3-on-surface);">{{ user.firstName }} {{ user.lastName }}</h2>
                    <p style="margin: 4px 0 0 0; color: var(--m3-on-surface-variant);">{{ user.email }}</p>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label class="m3-label" style="font-weight: 700; color: var(--m3-primary);">FIRST NAME</label>
                    <input type="text" value="{{ user.firstName }}" disabled class="m3-text-field" style="background: var(--m3-surface-container-low); opacity: 0.8;">
                </div>
                <div style="display: flex; flex-direction: column; gap: 8px;">
                    <label class="m3-label" style="font-weight: 700; color: var(--m3-primary);">LAST NAME</label>
                    <input type="text" value="{{ user.lastName }}" disabled class="m3-text-field" style="background: var(--m3-surface-container-low); opacity: 0.8;">
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="m3-label" style="font-weight: 700; color: var(--m3-primary);">PHONE NUMBER</label>
                <input type="tel" name="phone" value="{{ user.phone }}" class="m3-text-field" placeholder="+1234567890">
            </div>

            <hr style="border: 0; border-top: 1px solid var(--m3-outline-variant);">
            
            <div style="display: flex; flex-direction: column; gap: 24px;">
                <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--m3-on-surface);">Change Password</h3>
                <p style="margin: -16px 0 0 0; font-size: 0.875rem; color: var(--m3-on-surface-variant);">Leave blank to keep your current password.</p>
                
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <label class="m3-label">NEW PASSWORD</label>
                        <input type="password" name="new_password" class="m3-text-field">
                    </div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        <label class="m3-label">CONFIRM PASSWORD</label>
                        <input type="password" name="confirm_password" class="m3-text-field">
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 16px;">
                <button type="submit" class="m3-button m3-button-filled" style="flex: 1; height: 56px; font-size: 1.125rem; border-radius: 16px; font-weight: 600;">
                    Save Changes
                </button>
                <a href="{{ path('app_dashboard') }}" class="m3-button m3-button-outlined" style="flex: 1; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    document.getElementById('profile_picture').addEventListener('change', function(e) {
        if (this.files && this.files[0]) {
            var reader = new FileReader();
            reader.onload = function(e) {
                var img = document.querySelector('img[alt="Profile"]');
                if (img) {
                    img.src = e.target.result;
                } else {
                    // If no image, replace the placeholder
                    var placeholder = document.querySelector('div[style*="font-size: 3rem"]');
                    if (placeholder) {
                        var newImg = document.createElement('img');
                        newImg.src = e.target.result;
                        newImg.alt = "Profile";
                        newImg.style.width = "100%";
                        newImg.style.height = "100%";
                        newImg.style.borderRadius = "50%";
                        newImg.style.objectFit = "cover";
                        newImg.style.border = "4px solid var(--m3-primary-container)";
                        placeholder.parentNode.replaceChild(newImg, placeholder);
                    }
                }
            }
            reader.readAsDataURL(this.files[0]);
        }
    });
</script>
{% endblock %}
