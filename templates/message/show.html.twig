{% extends 'message/index.html.twig' %}

{% block chat_content %}
    {% set isMod = false %}
    {% for m in conversation.members %}
        {% if m.user == app.user and m.role == 'MOD' %}
            {% set isMod = true %}
        {% endif %}
    {% endfor %}

    {# ── CHAT HEADER ── #}
    <div style="padding: 16px 32px; border-bottom: 1px solid var(--m3-outline-variant); display: flex; align-items: center; justify-content: space-between; background: white;">
        <div style="display: flex; align-items: center; gap: 16px;">
            <div style="width: 40px; height: 40px; background: var(--m3-primary-container); color: var(--m3-on-primary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; overflow: hidden; border: 1px solid var(--m3-outline-variant);">
                {% if conversation.type == 'GROUP' %}
                    👥
                {% elseif recipient and recipient.profile_picture %}
                    <img src="{{ asset('uploads/profiles/' ~ recipient.profile_picture) }}" style="width: 100%; height: 100%; object-fit: cover;">
                {% else %}
                    {{ recipient ? recipient.firstName|first|upper : '?' }}
                {% endif %}
            </div>
            <div>
                <div style="font-weight: 600; color: var(--m3-on-surface); display: flex; align-items: center; gap: 8px;">
                    {{ conversation.type == 'GROUP' ? conversation.name : (recipient ? recipient.firstName ~ ' ' ~ recipient.lastName : 'Unknown') }}
                </div>
                <div style="font-size: 0.75rem; color: var(--m3-on-surface-variant); font-weight: 500;">
                    {% if conversation.type == 'GROUP' %}
                        {{ conversation.members|length }} members
                    {% else %}
                        Online
                    {% endif %}
                </div>
            </div>
        </div>

        {% if conversation.type == 'GROUP' %}
            <button onclick="openGroupInfoModal()" class="m3-button m3-button-tonal" style="height: 36px; padding: 0 16px; border-radius: 12px; display: flex; align-items: center; gap: 8px; background: #e0e2ec; color: #191c20; border: none; cursor: pointer; font-size: 0.8125rem;">
                ℹ️ Group Info
            </button>
        {% endif %}
    </div>

    {# ── MESSAGES LIST ── #}
    <div style="flex-grow: 1; overflow: hidden; display: flex; flex-direction: column;">
        <div id="message-container" 
             data-controller="socket"
             data-socket-url-value="{{ socketIoUrl }}"
             data-socket-room-value="conversation_{{ conversation.id }}"
             data-socket-current-user-id-value="{{ app.user.id }}"
             hx-on::after-settle="this.scrollTop = this.scrollHeight"
             style="flex-grow: 1; overflow-y: auto; padding: 32px; display: flex; flex-direction: column; gap: 16px; background: var(--m3-surface-container-lowest);">
            
            {% for msg in messages %}
                {% include 'message/_message.html.twig' with {'message': msg} %}
            {% endfor %}
        </div>
    </div>

    {# ── INPUT AREA ── #}
    <div style="padding: 24px 32px; background: white; border-top: 1px solid var(--m3-outline-variant);">
        <form id="message-form"
              hx-post="{{ path('app_messages_show', {id: conversation.id}) }}" 
              hx-target="#message-container" 
              hx-swap="beforeend"
              hx-on::after-request="
                var input = document.getElementById('message-form').querySelector('input[name=content]');
                if(input) input.value = '';
                var container = document.getElementById('message-container');
                if(container) container.scrollTop = container.scrollHeight;
              "
              hx-on::response-error="console.error('HTMX Error:', event.detail.xhr.status, event.detail.xhr.responseText)"
              style="display: flex; gap: 16px; align-items: center;">
            <input type="text" name="content" required placeholder="Type a message..." autocomplete="off" style="flex-grow: 1; height: 48px; border-radius: 24px; border: 1px solid var(--m3-outline); padding: 0 24px; font-size: 1rem; outline: none; background: var(--m3-surface-container-low);" onfocus="this.style.border='2px solid var(--m3-primary)'; this.style.padding='0 23px';" onblur="this.style.border='1px solid var(--m3-outline)'; this.style.padding='0 24px';">
            <button type="submit" class="m3-button m3-button-filled" style="width: 48px; height: 48px; border-radius: 50%; min-width: 48px; padding: 0; display: flex; align-items: center; justify-content: center;">
                <span style="font-size: 1.5rem;">✈️</span>
            </button>
        </form>
        <script>
            // Ensure form works reliably
            function initMessageForm() {
                const form = document.getElementById('message-form');
                if(!form) {
                    console.log('Message form not found yet, retrying...');
                    setTimeout(initMessageForm, 100);
                    return;
                }
                
                console.log('✓ Initializing message form');
                
                // Process form with HTMX
                if(window.htmx) {
                    htmx.process(form);
                    console.log('✓ HTMX processed form');
                }
                
                // Log all form submissions
                form.addEventListener('htmx:xhr:sendstart', function(e) {
                    console.log('✓ HTMX sending request to:', e.detail.requestConfig.path);
                });
                
                form.addEventListener('htmx:beforeRequest', function(e) {
                    console.log('✓ HTMX before request, method:', e.detail.requestConfig.verb, 'data:', e.detail.xhr.body);
                });
                
                form.addEventListener('htmx:afterRequest', function(e) {
                    console.log('✓ HTMX after request, status:', e.detail.xhr.status, 'response length:', e.detail.xhr.response.length);
                });
                
                form.addEventListener('htmx:responseError', function(e) {
                    console.error('✗ HTMX error:', e.detail.xhr.status, e.detail.xhr.responseText);
                });
                
                // Allow Enter key to submit
                const input = form.querySelector('input[name=content]');
                if(input) {
                    input.addEventListener('keypress', function(e) {
                        if(e.key === 'Enter' && !e.shiftKey) {
                            e.preventDefault();
                            console.log('✓ Enter key pressed, submitting form');
                            htmx.ajax('POST', form.getAttribute('hx-post'), {
                                source: form,
                                target: '#message-container',
                                swap: 'beforeend',
                                values: {content: input.value}
                            });
                            input.value = '';
                        }
                    });
                }
            }
            
            // Start initialization
            if(document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initMessageForm);
            } else {
                initMessageForm();
            }
        </script>
    </div>

    {# ── ACTION MODALS ── #}
    <div id="chat-modal-container" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); z-index: 1100; align-items: center; justify-content: center;">
        {# Edit Modal #}
        <div id="edit-message-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 440px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 20px;">
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 500;">Edit Message</h2>
            <form id="edit-message-form" method="POST">
                <textarea name="content" id="edit-content" required style="width: 100%; min-height: 100px; border-radius: 12px; border: 1px solid var(--m3-outline); padding: 12px; outline: none; font-family: inherit; font-size: 0.9375rem; box-sizing: border-box;"></textarea>
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px;">
                    <button type="button" onclick="closeChatModals()" class="m3-button m3-button-text">Cancel</button>
                    <button type="submit" class="m3-button m3-button-filled">Save Changes</button>
                </div>
            </form>
        </div>

        {# Forward Modal #}
        <div id="forward-message-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 440px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 20px;">
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 500;">Forward to...</h2>
            <form id="forward-message-form" method="POST">
                <input type="hidden" name="message_id" id="forward-msg-id">
                <div style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; border: 1px solid var(--m3-outline-variant); border-radius: 12px; padding: 8px;">
                    {% for conv in conversations %}
                        {% if conv.id != conversation.id %}
                        <label style="display: flex; align-items: center; gap: 12px; padding: 12px; cursor: pointer; border-radius: 12px;" onmouseover="this.style.background='var(--m3-surface-container-high)'" onmouseout="this.style.background='transparent'">
                            <input type="radio" name="target_conversation_id" value="{{ conv.id }}" required style="width: 20px; height: 20px;">
                            <div style="font-weight: 500;">
                                {% if conv.type == 'GROUP' %}{{ conv.name }}{% else %}
                                    {% for m in conv.members %}{% if m.user != app.user %}{{ m.user.firstName }} {{ m.user.lastName }}{% endif %}{% endfor %}
                                {% endif %}
                            </div>
                        </label>
                        {% endif %}
                    {% endfor %}
                </div>
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px;">
                    <button type="button" onclick="closeChatModals()" class="m3-button m3-button-text">Cancel</button>
                    <button type="submit" class="m3-button m3-button-filled">Forward Now</button>
                </div>
            </form>
        </div>

        {# Rename Group Modal #}
        <div id="rename-group-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 400px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 20px;">
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 500;">Rename Group</h2>
            <form action="{{ path('app_messages_group_update', {id: conversation.id}) }}" method="POST">
                <input type="text" name="name" value="{{ conversation.name }}" required style="width: 100%; height: 56px; border-radius: 12px; border: 1px solid var(--m3-outline); padding: 0 16px; outline: none; font-size: 1rem; box-sizing: border-box;">
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 16px;">
                    <button type="button" onclick="closeChatModals()" class="m3-button m3-button-text">Cancel</button>
                    <button type="submit" class="m3-button m3-button-filled">Update Name</button>
                </div>
            </form>
        </div>

        {# Group Info / Members Modal #}
        <div id="group-info-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 520px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; font-size: 1.5rem; font-weight: 500;">{{ conversation.name }}</h2>
                {% if isMod %}
                    <button onclick="openRenameGroupModal()" class="m3-button m3-button-text" style="font-size: 0.8rem;">✏️ Rename</button>
                {% endif %}
            </div>

            <div style="display: flex; flex-direction: column; gap: 16px;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="margin: 0; font-size: 1rem; font-weight: 600;">Members</h3>
                    {% if isMod %}
                        <button onclick="openAddMemberModal()" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 12px; font-size: 0.75rem; border-radius: 8px; background: #e0e2ec; color: #191c20; border: none; cursor: pointer;">➕ Add Member</button>
                    {% endif %}
                </div>
                
                <div style="max-height: 250px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;">
                    {% for m in conversation.members %}
                        <div style="display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 12px; background: var(--m3-surface-container-low);">
                            <div style="width: 32px; height: 32px; background: var(--m3-primary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem;">
                                {{ m.user.firstName|first|upper }}
                            </div>
                            <div style="flex-grow: 1;">
                                <div style="font-size: 0.9rem; font-weight: 500;">{{ m.user.firstName }} {{ m.user.lastName }}</div>
                                <div style="font-size: 0.7rem; color: var(--m3-on-surface-variant);">{{ m.role|lower }}</div>
                            </div>
                            {% if isMod and m.user != app.user %}
                                <form action="{{ path('app_messages_group_remove_member', {id: conversation.id, userId: m.user.id}) }}" method="POST" onsubmit="return confirm('Remove this member?')">
                                    <button type="submit" style="background: none; border: none; cursor: pointer; color: var(--m3-error); font-size: 1rem;">✕</button>
                                </form>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            <div style="display: flex; flex-direction: column; gap: 12px; margin-top: 16px; border-top: 1px solid var(--m3-outline-variant); padding-top: 24px;">
                <form action="{{ path('app_messages_group_leave', {id: conversation.id}) }}" method="POST" onsubmit="return confirm('Are you sure you want to leave this group?')">
                    <button type="submit" class="m3-button m3-button-tonal" style="width: 100%; height: 44px; border-radius: 12px; background: #fee2e2; color: #991b1b; border: none; cursor: pointer; font-weight: 600;">🚪 Leave Group</button>
                </form>
                {% if isMod %}
                    <form action="{{ path('app_messages_group_delete', {id: conversation.id}) }}" method="POST" onsubmit="return confirm('CRITICAL: This will delete the entire group and all messages. Proceed?')">
                        <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 44px; border-radius: 12px; background: var(--m3-error); color: white; border: none; cursor: pointer; font-weight: 600;">🗑️ Delete Group</button>
                    </form>
                {% endif %}
            </div>
        </div>

        {# Add Member Modal #}
        <div id="add-member-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 440px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 20px;">
            <h2 style="margin: 0; font-size: 1.25rem; font-weight: 500;">Add to Group</h2>
            <div id="add-member-list" style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;">
                <!-- Loaded via JS -->
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button onclick="openGroupInfoModal()" class="m3-button m3-button-text">Back</button>
            </div>
        </div>
    </div>

    <script>
        function openEditModal(id, content) {
            const modal = document.getElementById('edit-message-modal');
            const form = document.getElementById('edit-message-form');
            const textarea = document.getElementById('edit-content');
            
            form.action = `/messages/${id}/edit`;
            textarea.value = content;
            
            document.getElementById('chat-modal-container').style.display = 'flex';
            modal.style.display = 'flex';
            document.getElementById('forward-message-modal').style.display = 'none';
            document.getElementById('rename-group-modal').style.display = 'none';
        }

        function openForwardModal(id) {
            const modal = document.getElementById('forward-message-modal');
            const form = document.getElementById('forward-message-form');
            
            form.action = `/messages/${id}/forward`;
            
            document.getElementById('chat-modal-container').style.display = 'flex';
            modal.style.display = 'flex';
            document.getElementById('edit-message-modal').style.display = 'none';
            document.getElementById('rename-group-modal').style.display = 'none';
        }

        function openRenameGroupModal() {
            const modal = document.getElementById('rename-group-modal');
            document.getElementById('chat-modal-container').style.display = 'flex';
            modal.style.display = 'flex';
            document.getElementById('edit-message-modal').style.display = 'none';
            document.getElementById('forward-message-modal').style.display = 'none';
            document.getElementById('group-info-modal').style.display = 'none';
            document.getElementById('add-member-modal').style.display = 'none';
        }

        function openGroupInfoModal() {
            const modal = document.getElementById('group-info-modal');
            document.getElementById('chat-modal-container').style.display = 'flex';
            modal.style.display = 'flex';
            document.getElementById('edit-message-modal').style.display = 'none';
            document.getElementById('forward-message-modal').style.display = 'none';
            document.getElementById('rename-group-modal').style.display = 'none';
            document.getElementById('add-member-modal').style.display = 'none';
        }

        async function openAddMemberModal() {
            const modal = document.getElementById('add-member-modal');
            const list = document.getElementById('add-member-list');
            list.innerHTML = '<div style="text-align:center;padding:20px;">Loading contacts...</div>';
            
            document.getElementById('chat-modal-container').style.display = 'flex';
            modal.style.display = 'flex';
            document.getElementById('group-info-modal').style.display = 'none';

            try {
                const response = await fetch('{{ path('app_messages_api_contacts') }}');
                const contacts = await response.json();
                list.innerHTML = '';
                
                contacts.forEach(c => {
                    const item = document.createElement('div');
                    item.style.display = 'flex';
                    item.style.alignItems = 'center';
                    item.style.gap = '12px';
                    item.style.padding = '12px';
                    item.style.borderRadius = '12px';
                    item.onmouseover = () => item.style.background = 'var(--m3-surface-container-high)';
                    item.onmouseout = () => item.style.background = 'transparent';
                    
                    item.innerHTML = `
                        <div style="width: 32px; height: 32px; background: var(--m3-primary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; overflow: hidden;">
                            ${c.avatar ? `<img src="${c.avatar}" style="width:100%;height:100%;object-fit:cover;">` : c.name.charAt(0)}
                        </div>
                        <div style="flex-grow:1;">
                            <div style="font-weight: 500; font-size: 0.9rem;">${c.name}</div>
                            <div style="font-size: 0.7rem; color: var(--m3-on-surface-variant);">${c.role.replace('ROLE_', '').toLowerCase()}</div>
                        </div>
                        <form action="{{ path('app_messages_group_add_member', {id: conversation.id}) }}" method="POST">
                            <input type="hidden" name="user_id" value="${c.id}">
                            <button type="submit" class="m3-button m3-button-text" style="font-size: 1.2rem;">➕</button>
                        </form>
                    `;
                    list.appendChild(item);
                });
            } catch (e) {
                list.innerHTML = '<div style="color:var(--m3-error);padding:20px;">Failed to load contacts</div>';
            }
        }

        function closeChatModals() {
            document.getElementById('chat-modal-container').style.display = 'none';
        }

        async function deleteMessage(id) {
            if (!confirm('Are you sure you want to delete this message?')) return;
            
            try {
                const response = await fetch(`/messages/${id}/delete`, {
                    method: 'POST',
                    headers: { 'HX-Request': 'true' }
                });
                if (response.ok) {
                    const html = await response.text();
                    const el = document.querySelector(`[data-message-id="${id}"]`);
                    if (el) el.outerHTML = html;
                }
            } catch (e) {
                console.error('Delete failed', e);
            }
        }

        // Close on backdrop click
        document.getElementById('chat-modal-container').addEventListener('click', (e) => {
            if (e.target.id === 'chat-modal-container') closeChatModals();
        });
    </script>
{% endblock %}
