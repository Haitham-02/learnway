{% extends 'base.html.twig' %}

{% block title %}Messages — LearnWay{% endblock %}

{% block body %}
<div style="display: flex; height: calc(100vh - 112px); margin: -24px; background: var(--m3-surface);">
    {# ── LEFT SIDEBAR: CONVERSATIONS ── #}
    <div style="width: 360px; border-right: 1px solid var(--m3-outline-variant); background: var(--m3-surface-container-low); display: flex; flex-direction: column;">
        <div style="padding: 24px; border-bottom: 1px solid var(--m3-outline-variant); display: flex; flex-direction: column; gap: 16px;">
            <h1 style="margin: 0; font-size: 1.5rem; font-weight: 600; color: var(--m3-on-surface);">Messages</h1>
            
            <div style="position: relative;">
                <span class="material-symbols-rounded" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 1.25rem; color: var(--m3-on-surface-variant);">search</span>
                <input type="text" id="sidebar-search" placeholder="Search conversations..." style="width: 100%; height: 44px; border-radius: 22px; border: 1px solid var(--m3-outline-variant); padding: 0 16px 0 44px; font-size: 0.875rem; outline: none; background: var(--m3-surface-container-high); box-sizing: border-box;" onfocus="this.style.border='2px solid var(--m3-primary)'; this.style.padding='0 15px 0 43px';" onblur="this.style.border='1px solid var(--m3-outline-variant)'; this.style.padding='0 16px 0 44px';">
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <button onclick="openNewMessageModal()" class="m3-button m3-button-tonal" style="width: 100%; height: 36px; padding: 0 16px; font-size: 0.8125rem; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; background: #e0e2ec; color: #191c20; border: none; cursor: pointer; font-family: inherit; font-weight: 500;">
                    New Conversation
                </button>
                <button onclick="openNewGroupModal()" class="m3-button m3-button-tonal" style="width: 100%; height: 36px; padding: 0 16px; font-size: 0.8125rem; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; background: #e0e2ec; color: #191c20; border: none; cursor: pointer; font-family: inherit; font-weight: 500;">
                    Create Group Chat
                </button>
                {% if not is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('app_messages_contact_admin') }}" class="m3-button m3-button-tonal" style="height: 36px; padding: 0 16px; font-size: 0.8125rem; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; background: #e0e2ec; color: #191c20; font-weight: 500;">
                        🛡️ Support Admin
                    </a>
                {% endif %}
            </div>
        </div>
        
        <div id="conversations-list" style="flex-grow: 1; overflow-y: auto;">
            {% for conv in conversations %}
                {% set otherMember = null %}
                {% for m in conv.members %}
                    {% if m.user != app.user %}
                        {% set otherMember = m.user %}
                    {% endif %}
                {% endfor %}
                
                <a href="{{ path('app_messages_show', {id: conv.id}) }}" style="display: flex; align-items: center; gap: 16px; padding: 16px 24px; text-decoration: none; color: inherit; transition: background 0.2s; {% if conversation is defined and conversation.id == conv.id %}background: var(--m3-secondary-container); color: var(--m3-on-secondary-container);{% endif %}" onmouseover="this.style.background='var(--m3-surface-container-high)'" onmouseout="this.style.background='{% if conversation is defined and conversation.id == conv.id %}var(--m3-secondary-container){% else %}transparent{% endif %}'">
                    <div style="width: 48px; height: 48px; background: var(--m3-primary-container); color: var(--m3-on-primary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 1.25rem; overflow: hidden; border: 1px solid var(--m3-outline-variant);">
                        {% if otherMember and otherMember.profilePicture %}
                            <img src="{{ asset('uploads/profiles/' ~ otherMember.profilePicture) }}" style="width: 100%; height: 100%; object-fit: cover;">
                        {% else %}
                            {{ otherMember ? otherMember.firstName|first|upper : '?' }}
                        {% endif %}
                    </div>
                    <div style="flex-grow: 1; overflow: hidden;">
                        <div style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            {% if conv.type == 'GROUP' %}
                                {{ conv.name }}
                            {% else %}
                                {{ otherMember ? otherMember.firstName ~ ' ' ~ otherMember.lastName : 'Unknown' }}
                            {% endif %}
                        </div>
                        <div style="font-size: 0.8125rem; color: var(--m3-on-surface-variant); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                            {% if conv.messages|length > 0 %}
                                {% set lastMsg = conv.messages|last %}
                                {{ lastMsg.user == app.user ? 'You: ' : lastMsg.user.firstName ~ ': ' }}{{ lastMsg.content }}
                            {% else %}
                                No messages yet
                            {% endif %}
                        </div>
                    </div>
                    {% if conv.messages|length > 0 %}
                        <div style="font-size: 0.75rem; color: var(--m3-on-surface-variant);">
                            {{ conv.messages|last.sentAt|date('H:i') }}
                        </div>
                    {% endif %}
                </a>
            {% else %}
                <div style="padding: 48px 24px; text-align: center; color: var(--m3-on-surface-variant);">
                    <div style="font-size: 3rem; margin-bottom: 16px; opacity: 0.3;">💬</div>
                    <p>No conversations yet.</p>
                </div>
            {% endfor %}
        </div>
    </div>

    {# ── RIGHT AREA: CHAT ── #}
    <div style="flex-grow: 1; display: flex; flex-direction: column; background: white;">
        {% block chat_content %}
            <div style="flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--m3-on-surface-variant);">
                <div style="font-size: 5rem; margin-bottom: 24px; opacity: 0.1;">✉️</div>
                <h2 style="margin: 0; font-weight: 400;">Select a conversation to start chatting</h2>
                <p style="margin-top: 8px;">Or contact someone from their profile or class list.</p>
            </div>
        {% endblock %}
    </div>
</div>

{# ── MODALS ── #}
<div id="modal-container" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.4); backdrop-filter: blur(8px); z-index: 1000; align-items: center; justify-content: center;">
    {# New Message Modal #}
    <div id="new-message-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 480px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 24px;">
        <h2 style="margin: 0; font-size: 1.5rem; font-weight: 500;">New Message</h2>
        <input type="text" id="contact-search" placeholder="Search students or teachers..." style="width: 100%; height: 56px; border-radius: 16px; border: 1px solid var(--m3-outline); padding: 0 20px; outline: none; font-size: 1rem; box-sizing: border-box;">
        <div id="contacts-list" style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px;">
            <!-- Contacts will be loaded here -->
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 12px;">
            <button onclick="closeModals()" class="m3-button m3-button-text">Cancel</button>
        </div>
    </div>

    {# New Group Modal #}
    <div id="new-group-modal" class="m3-card m3-card-elevated" style="display: none; width: 100%; max-width: 480px; background: white; border-radius: 28px; padding: 32px; flex-direction: column; gap: 24px;">
        <h2 style="margin: 0; font-size: 1.5rem; font-weight: 500;">Create Group</h2>
        <form action="{{ path('app_messages_group_create') }}" method="POST" style="display: flex; flex-direction: column; gap: 20px;">
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="font-size: 0.75rem; font-weight: 600; color: var(--m3-primary);">GROUP NAME</label>
                <input type="text" name="name" required placeholder="Project Team X..." style="width: 100%; height: 56px; border-radius: 16px; border: 1px solid var(--m3-outline); padding: 0 20px; outline: none; font-size: 1rem; box-sizing: border-box;">
            </div>
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label style="font-size: 0.75rem; font-weight: 600; color: var(--m3-primary);">SELECT MEMBERS</label>
                <input type="text" id="group-contact-search" placeholder="Search members..." style="width: 100%; height: 48px; border-radius: 12px; border: 1px solid var(--m3-outline); padding: 0 16px; outline: none; font-size: 0.875rem; box-sizing: border-box; margin-bottom: 8px;">
                <div id="selected-chips" style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; min-height: 24px;"></div>
                <div id="group-contacts-list" style="max-height: 200px; overflow-y: auto; display: flex; flex-direction: column; gap: 4px; border: 1px solid var(--m3-outline-variant); border-radius: 12px; padding: 8px;">
                    <!-- Contacts will be loaded here -->
                </div>
                <div id="selected-users-hidden"></div>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 8px;">
                <button type="button" onclick="closeModals()" class="m3-button m3-button-text">Cancel</button>
                <button type="submit" class="m3-button m3-button-filled">Create Group</button>
            </div>
        </form>
    </div>
</div>

<script>
(function() {
    let allContacts = [];
    let selectedGroupUsers = new Set();

    async function fetchContacts() {
        try {
            const response = await fetch('{{ path('app_messages_api_contacts') }}');
            allContacts = await response.json();
            renderSingleContacts(document.getElementById('contact-search').value);
            renderGroupContacts(document.getElementById('group-contact-search').value);
        } catch (e) {
            console.error('Failed to fetch contacts', e);
        }
    }

    function getFilteredAndSortedContacts(search) {
        const s = search.toLowerCase();
        let filtered = allContacts.filter(c => c.name.toLowerCase().includes(s));
        filtered.sort((a, b) => {
            const aName = a.name.toLowerCase();
            const bName = b.name.toLowerCase();
            const aStarts = aName.startsWith(s);
            const bStarts = bName.startsWith(s);
            if (aStarts && !bStarts) return -1;
            if (!aStarts && bStarts) return 1;
            return aName.localeCompare(bName);
        });
        return { filtered, s };
    }

    function highlightMatch(name, searchStr) {
        if (!searchStr) return name;
        const regex = new RegExp(`(${searchStr})`, 'gi');
        return name.replace(regex, '<span style="color: var(--m3-primary); font-weight: 800;">$1</span>');
    }

    function renderSingleContacts(search) {
        const list = document.getElementById('contacts-list');
        list.innerHTML = '';
        
        const { filtered, s } = getFilteredAndSortedContacts(search);

        if (filtered.length === 0) {
            list.innerHTML = `<div style="padding: 20px; text-align: center; color: var(--m3-on-surface-variant); font-size: 0.875rem; opacity: 0.7;">No matches found</div>`;
            return;
        }

        filtered.forEach(c => {
            const formattedRole = c.role.replace('ROLE_', '').toLowerCase();
            const displayName = highlightMatch(c.name, s);
            
            const item = document.createElement('a');
            item.href = `/messages/start/${c.id}`;
            item.style.display = 'flex';
            item.style.alignItems = 'center';
            item.style.gap = '12px';
            item.style.padding = '12px';
            item.style.textDecoration = 'none';
            item.style.color = 'inherit';
            item.style.borderRadius = '12px';
            item.onmouseover = () => item.style.background = 'var(--m3-surface-container-high)';
            item.onmouseout = () => item.style.background = 'transparent';
            item.innerHTML = `
                <div style="width: 32px; height: 32px; background: var(--m3-primary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; overflow: hidden;">
                    ${c.avatar ? `<img src="${c.avatar}" style="width:100%;height:100%;object-fit:cover;">` : c.name.charAt(0)}
                </div>
                <div>
                    <div style="font-weight: 500;">${displayName}</div>
                    <div style="font-size: 0.7rem; color: var(--m3-on-surface-variant);">${formattedRole}</div>
                </div>
            `;
            list.appendChild(item);
        });
    }

    function renderGroupContacts(search) {
        const groupList = document.getElementById('group-contacts-list');
        groupList.innerHTML = '';
        
        const { filtered, s } = getFilteredAndSortedContacts(search);

        if (filtered.length === 0) {
            groupList.innerHTML = `<div style="padding: 20px; text-align: center; color: var(--m3-on-surface-variant); font-size: 0.875rem; opacity: 0.7;">No matches found</div>`;
            return;
        }

        filtered.forEach(c => {
            const formattedRole = c.role.replace('ROLE_', '').toLowerCase();
            const displayName = highlightMatch(c.name, s);
            
            const groupItem = document.createElement('label');
            groupItem.style.display = 'flex';
            groupItem.style.alignItems = 'center';
            groupItem.style.gap = '12px';
            groupItem.style.padding = '8px';
            groupItem.style.cursor = 'pointer';
            groupItem.style.borderRadius = '8px';
            groupItem.onmouseover = () => groupItem.style.background = 'var(--m3-surface-container-high)';
            groupItem.onmouseout = () => groupItem.style.background = 'transparent';
            
            const isChecked = selectedGroupUsers.has(String(c.id));
            groupItem.innerHTML = `
                <input type="checkbox" value="${c.id}" ${isChecked ? 'checked' : ''} onchange="window.toggleGroupUser('${c.id}')" style="width: 18px; height: 18px;">
                <div style="font-size: 0.9rem; font-weight: 500;">${displayName}</div>
                <div style="font-size: 0.7rem; color: var(--m3-on-surface-variant); margin-left: auto;">${formattedRole}</div>
            `;
            groupList.appendChild(groupItem);
        });
    }

    window.toggleGroupUser = function(userId) {
        if (selectedGroupUsers.has(userId)) {
            selectedGroupUsers.delete(userId);
        } else {
            selectedGroupUsers.add(userId);
        }
        updateHiddenInputs();
    };

    function updateHiddenInputs() {
        const container = document.getElementById('selected-users-hidden');
        const chipsContainer = document.getElementById('selected-chips');
        container.innerHTML = '';
        chipsContainer.innerHTML = '';
        
        selectedGroupUsers.forEach(id => {
            // Hidden Input
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'users[]';
            input.value = id;
            container.appendChild(input);

            // Chip UI
            const contact = allContacts.find(c => String(c.id) === id);
            if (contact) {
                const chip = document.createElement('div');
                chip.style.cssText = `
                    background: var(--m3-secondary-container);
                    color: var(--m3-on-secondary-container);
                    padding: 4px 12px;
                    border-radius: 16px;
                    font-size: 0.75rem;
                    font-weight: 600;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                    cursor: pointer;
                `;
                chip.onclick = () => {
                    window.toggleGroupUser(id);
                    renderGroupContacts(document.getElementById('group-contact-search').value);
                };
                chip.innerHTML = `${contact.name} <span style="opacity: 0.6">×</span>`;
                chipsContainer.appendChild(chip);
            }
        });
    }

    document.getElementById('contact-search').addEventListener('input', (e) => renderSingleContacts(e.target.value));
    document.getElementById('group-contact-search').addEventListener('input', (e) => renderGroupContacts(e.target.value));

    window.openNewMessageModal = function() {
        document.getElementById('modal-container').style.display = 'flex';
        document.getElementById('new-message-modal').style.display = 'flex';
        document.getElementById('new-group-modal').style.display = 'none';
        document.getElementById('contact-search').value = '';
        fetchContacts();
    };

    window.openNewGroupModal = function() {
        document.getElementById('modal-container').style.display = 'flex';
        document.getElementById('new-group-modal').style.display = 'flex';
        document.getElementById('new-message-modal').style.display = 'none';
        document.getElementById('group-contact-search').value = '';
        selectedGroupUsers.clear();
        updateHiddenInputs();
        fetchContacts();
    };

    window.closeModals = function() {
        document.getElementById('modal-container').style.display = 'none';
    };

    // Sidebar Filtering
    document.getElementById('sidebar-search').addEventListener('input', function(e) {
        const s = e.target.value.toLowerCase();
        const items = document.querySelectorAll('#conversations-list > a');
        
        items.forEach(item => {
            const name = item.querySelector('div[style*="font-weight: 600"]').textContent.toLowerCase();
            if (name.includes(s)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });
    });

    // Close on backdrop click
    document.getElementById('modal-container').addEventListener('click', (e) => {
        if (e.target.id === 'modal-container') window.closeModals();
    });
})();
</script>
{% endblock %}
