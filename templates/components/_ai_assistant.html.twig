{% set role = is_granted('ROLE_ADMIN') ? 'admin' : (is_granted('ROLE_TEACHER') ? 'teacher' : 'student') %}
{% set suggestions = [] %}
{% set welcome_msg = "" %}

{% if role == 'admin' %}
    {% set suggestions = [
        { icon: '📊', text: 'How many active students do we have?' },
        { icon: '🛡️', text: 'Are there any forum posts pending approval?' },
        { icon: '📢', text: 'Show me an overview of recent announcements.' },
        { icon: '🧑‍🏫', text: 'Who are the most active teachers?' }
    ] %}
    {% set welcome_msg = "👋 Hi **" ~ app.user.first_name ~ "**! I'm your **Learnway Copilot**.<br><br>As an **Admin**, I can help you monitor student activity, manage forum moderation, and track platform engagement. How can I assist you today?" %}
{% elseif role == 'teacher' %}
    {% set suggestions = [
        { icon: '📅', text: 'Show me my upcoming classes.' },
        { icon: '📝', text: 'Are there any new assignment submissions?' },
        { icon: '💬', text: "What's the engagement in my forum topics?" },
        { icon: '📢', text: 'Help me draft an announcement for my students.' }
    ] %}
    {% set welcome_msg = "👋 Hi **" ~ app.user.first_name ~ "**! I'm your **Learnway Copilot**.<br><br>As a **Teacher**, I'm here to help you manage your classes, track student progress, and facilitate forum discussions. What's on your agenda?" %}
{% else %}
    {% set suggestions = [
        { icon: '📚', text: 'What are my current lessons?' },
        { icon: '📋', text: 'Show my upcoming assignments' },
        { icon: '📡', text: 'Any upcoming livestreams?' },
        { icon: '💬', text: "What's new in the forum?" },
        { icon: '📢', text: 'Any announcements for me?' }
    ] %}
    {% set welcome_msg = "👋 Hi **" ~ app.user.first_name ~ "**! I'm your **Learnway Copilot**.<br><br>I have full access to your classes, assignments, lessons, livestreams, forum, and messages. Ask me anything!" %}
{% endif %}

<div id="learnway-copilot"
     data-controller="ai-assistant"
     data-ai-assistant-chat-url-value="{{ path('api_ai_chat') }}"
     data-ai-assistant-upload-url-value="{{ path('api_ai_upload') }}"
     data-ai-assistant-suggestions-value="{{ suggestions|json_encode }}"
     data-ai-assistant-logo-url-value="{{ asset('images/LearnWay logo.png') }}">

    {# ... rest of the FAB and Header remains the same ... #}
    {# ── FAB Button ── #}
    <button data-ai-assistant-target="fab"
            data-action="mousedown->ai-assistant#dragStart touchstart->ai-assistant#dragStart"
            class="copilot-fab"
            title="Learnway Copilot">
        <img src="{{ asset('images/LearnWay logo.png') }}" style="width: 32px; height: 32px; object-fit: contain; filter: drop-shadow(0 0 8px rgba(255,255,255,0.4));">
    </button>

    {# ── Copilot Panel ── #}
    <div data-ai-assistant-target="panel" class="copilot-panel">

        {# Header #}
        <div class="copilot-header">
            <div class="copilot-header-brand">
                <div class="copilot-header-avatar" style="background: transparent; box-shadow: none;">
                    <img src="{{ asset('images/LearnWay logo.png') }}" style="width: 24px; height: 24px; object-fit: contain;">
                </div>
                <div>
                    <div class="copilot-header-title">Learnway Copilot</div>
                    <div class="copilot-header-subtitle">Your AI-powered study assistant</div>
                </div>
            </div>
            <div class="copilot-header-actions">
                <button data-action="click->ai-assistant#clearChat" class="copilot-icon-btn" title="Clear chat">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
                </button>
                <button data-action="click->ai-assistant#togglePanel" class="copilot-icon-btn" title="Close">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
        </div>

        {# Messages #}
        <div data-ai-assistant-target="messages" class="copilot-messages">
            <div class="copilot-msg copilot-msg--assistant visible">
                <div class="copilot-avatar" style="background: transparent; box-shadow: none;">
                    <img src="{{ asset('images/LearnWay logo.png') }}" style="width: 20px; height: 20px; object-fit: contain;">
                </div>
                <div class="copilot-bubble copilot-bubble--ai">
                    {{ welcome_msg|raw }}
                </div>
            </div>
        </div>

        {# Suggestion Chips #}
        <div data-ai-assistant-target="suggestions" class="copilot-suggestions"></div>

        {# Input Area #}
        <div class="copilot-input-area">
            <label class="copilot-attach" title="Upload a document">
                <input type="file" data-action="change->ai-assistant#uploadFile" accept=".pdf,.txt,.docx" style="display:none;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/></svg>
            </label>
            <textarea data-ai-assistant-target="input"
                      class="copilot-textarea"
                      placeholder="Ask about your classes, assignments, lessons…"
                      rows="2"></textarea>
            <button data-action="click->ai-assistant#sendMessage" class="copilot-send-btn" title="Send">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"/></svg>
            </button>
        </div>

        <div class="copilot-footer">Secured by RAG · Context-aware · Role-isolated</div>
    </div>
</div>

<style>
/* ─── Core ─── */
#learnway-copilot {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 9999;
    font-family: 'Roboto', sans-serif;
}

/* ─── FAB ─── */
.copilot-fab {
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: linear-gradient(135deg, #224870, #4ea5d9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 20px rgba(78, 165, 217, 0.45);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    margin-left: auto;
}
.copilot-fab:hover {
    transform: scale(1.08);
    box-shadow: 0 6px 28px rgba(78, 165, 217, 0.65);
}
.copilot-fab.open {
    background: linear-gradient(135deg, #1a3a5e, #2a7fb5);
    transform: rotate(15deg) scale(1.05);
}
.copilot-fab-icon {
    font-size: 22px;
    color: white;
    font-style: normal;
    transition: transform 0.3s;
    line-height: 1;
}

/* ─── Panel ─── */
.copilot-panel {
    display: none;
    position: absolute;
    bottom: 70px;
    right: 0;
    width: 380px;
    height: 590px;
    background: #0d1b2a;
    border-radius: 20px;
    border: 1px solid rgba(78, 165, 217, 0.15);
    box-shadow: 0 24px 80px rgba(0,0,0,0.55), 0 0 0 1px rgba(78,165,217,0.2);
    flex-direction: column;
    overflow: hidden;
    opacity: 0;
    transform: translateY(16px) scale(0.97);
    transition: opacity 0.2s ease, transform 0.2s ease;
}

/* ─── Header ─── */
.copilot-header {
    padding: 16px 16px 14px;
    background: linear-gradient(135deg, #0f2338, #162d4a);
    border-bottom: 1px solid rgba(78, 165, 217, 0.12);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
}
.copilot-header-brand { display: flex; align-items: center; gap: 10px; }
.copilot-header-avatar {
    width: 36px; height: 36px; border-radius: 12px;
    background: linear-gradient(135deg, #2a4494, #4ea5d9);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; color: white;
    box-shadow: 0 0 16px rgba(78, 165, 217, 0.4);
}
.copilot-header-title { font-size: 14px; font-weight: 600; color: #e0f2fe; letter-spacing: 0.01em; }
.copilot-header-subtitle { font-size: 11px; color: rgba(186, 230, 253, 0.5); margin-top: 1px; }
.copilot-header-actions { display: flex; gap: 4px; }
.copilot-icon-btn {
    width: 30px; height: 30px; border-radius: 8px;
    background: rgba(78, 165, 217, 0.08); border: none; cursor: pointer;
    color: rgba(186, 230, 253, 0.6);
    display: flex; align-items: center; justify-content: center;
    transition: background 0.15s, color 0.15s;
}
.copilot-icon-btn:hover { background: rgba(78, 165, 217, 0.18); color: #e0f2fe; }

/* ─── Messages ─── */
.copilot-messages {
    flex: 1;
    overflow-y: auto;
    padding: 16px 14px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    scrollbar-width: thin;
    scrollbar-color: rgba(78, 165, 217, 0.3) transparent;
}
.copilot-messages::-webkit-scrollbar { width: 4px; }
.copilot-messages::-webkit-scrollbar-track { background: transparent; }
.copilot-messages::-webkit-scrollbar-thumb { background: rgba(78, 165, 217, 0.35); border-radius: 4px; }

.copilot-msg {
    display: flex; gap: 8px; align-items: flex-end;
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.25s ease, transform 0.25s ease;
}
.copilot-msg.visible { opacity: 1; transform: translateY(0); }
.copilot-msg--user { flex-direction: row-reverse; }
.copilot-msg--upload { justify-content: center; }

.copilot-avatar {
    width: 28px; height: 28px; min-width: 28px; border-radius: 10px;
    background: linear-gradient(135deg, #2a4494, #4ea5d9);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px; color: white;
    box-shadow: 0 0 10px rgba(78, 165, 217, 0.35);
}

.copilot-bubble {
    max-width: 82%; padding: 10px 14px;
    border-radius: 16px; font-size: 13.5px; line-height: 1.6;
}
.copilot-bubble--ai {
    background: rgba(42, 68, 148, 0.18);
    border: 1px solid rgba(78, 165, 217, 0.2);
    color: #e0f2fe;
    border-radius: 16px 16px 16px 4px;
}
.copilot-bubble--ai code {
    background: rgba(78, 165, 217, 0.12); padding: 1px 5px;
    border-radius: 4px; font-family: 'Courier New', monospace;
    font-size: 12px; color: #44cfcb;
}
.copilot-bubble--ai ul { margin: 6px 0; padding-left: 18px; }
.copilot-bubble--ai li { margin-bottom: 3px; }
.copilot-bubble--ai strong { color: #7dd3fc; }
.copilot-heading { font-weight: 600; color: #4ea5d9; font-size: 14px; margin: 6px 0 2px; }
.copilot-bubble--user {
    background: linear-gradient(135deg, #224870, #2a4494);
    color: white; border-radius: 16px 16px 4px 16px;
    box-shadow: 0 2px 12px rgba(42, 68, 148, 0.4);
}
.copilot-bubble--upload {
    background: rgba(78, 165, 217, 0.06);
    border: 1px dashed rgba(78, 165, 217, 0.25);
    color: rgba(186, 230, 253, 0.7);
    border-radius: 10px; font-size: 12px; padding: 8px 14px;
}

/* ─── Typing dots ─── */
.copilot-typing .copilot-bubble { padding: 12px 16px; display: flex; gap: 5px; align-items: center; }
.dot {
    width: 6px; height: 6px; background: #4ea5d9;
    border-radius: 50%; animation: bounce 1.2s infinite; display: inline-block;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.35; }
    30% { transform: translateY(-5px); opacity: 1; }
}

/* ─── Suggestions ─── */
.copilot-suggestions {
    display: flex; flex-wrap: wrap; gap: 6px;
    padding: 0 14px 10px; flex-shrink: 0; transition: opacity 0.2s;
}
.copilot-suggestion {
    display: flex; align-items: center; gap: 5px;
    padding: 6px 11px; border-radius: 20px;
    background: rgba(78, 165, 217, 0.08);
    border: 1px solid rgba(78, 165, 217, 0.2);
    color: rgba(186, 230, 253, 0.85); font-size: 11.5px; cursor: pointer;
    transition: background 0.15s, border-color 0.15s, transform 0.1s;
    white-space: nowrap;
}
.copilot-suggestion:hover {
    background: rgba(78, 165, 217, 0.2);
    border-color: rgba(78, 165, 217, 0.45);
    color: #e0f2fe; transform: translateY(-1px);
}
.suggestion-icon { font-size: 13px; }

/* ─── Input Area ─── */
.copilot-input-area {
    padding: 10px 12px;
    background: rgba(13, 27, 42, 0.8);
    border-top: 1px solid rgba(78, 165, 217, 0.1);
    display: flex; align-items: flex-end; gap: 8px; flex-shrink: 0;
}
.copilot-textarea {
    flex: 1;
    background: rgba(78, 165, 217, 0.06);
    border: 1px solid rgba(78, 165, 217, 0.15);
    border-radius: 14px; color: #e0f2fe;
    font-size: 13.5px; padding: 10px 14px;
    resize: none; outline: none;
    font-family: 'Roboto', sans-serif; line-height: 1.5;
    min-height: 44px; max-height: 120px; overflow-y: auto;
    transition: border-color 0.2s;
}
.copilot-textarea::placeholder { color: rgba(186, 230, 253, 0.45); font-size: 13px; }
.copilot-textarea:focus { border-color: rgba(78, 165, 217, 0.5); }

.copilot-attach {
    width: 36px; height: 36px; border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; color: rgba(186, 230, 253, 0.5);
    background: rgba(78, 165, 217, 0.08);
    transition: background 0.15s, color 0.15s; flex-shrink: 0;
}
.copilot-attach:hover { background: rgba(78, 165, 217, 0.18); color: #e0f2fe; }

.copilot-send-btn {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, #224870, #4ea5d9);
    border: none; cursor: pointer; color: white;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; transition: transform 0.15s, box-shadow 0.15s;
    box-shadow: 0 2px 10px rgba(78, 165, 217, 0.35);
}
.copilot-send-btn:hover { transform: scale(1.08); box-shadow: 0 4px 16px rgba(78, 165, 217, 0.55); }
.copilot-send-btn:active { transform: scale(0.95); }

/* ─── Footer ─── */
.copilot-footer {
    text-align: center; font-size: 10px;
    color: rgba(186, 230, 253, 0.2);
    padding: 6px 0 10px; letter-spacing: 0.04em;
}
</style>
