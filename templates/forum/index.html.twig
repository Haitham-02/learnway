{% extends 'base.html.twig' %}

{% block title %}Forum — LearnWay{% endblock %}

{% block body %}
<div style="padding-bottom: 64px;">
    
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 40px;">
        <div>
            <h1 style="margin: 0; font-size: 2.5rem; font-weight: 300; color: var(--m3-on-surface);">Community <span style="font-weight: 700; color: var(--m3-primary);">Forum</span></h1>
            <p style="margin: 8px 0 0 0; color: var(--m3-on-surface-variant); font-size: 1.125rem;">Discuss, share, and learn with your peers.</p>
        </div>
        {% if is_granted('ROLE_STUDENT') or is_granted('ROLE_TEACHER') %}
            <a href="{{ path('app_forum_new') }}" class="m3-button m3-button-filled" style="height: 48px; padding: 0 24px; border-radius: 12px; gap: 8px;">
                <span style="font-size: 1.25rem;">+</span> Start Discussion
            </a>
        {% endif %}
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 32px; display: flex; align-items: center; gap: 12px; border: 1px solid var(--m3-primary);">
            <span>✅</span>
            {{ message }}
        </div>
    {% endfor %}

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(400px, 1fr)); gap: 24px;">
        {% for post in posts %}
            <a href="{{ path('app_forum_show', {id: post.id}) }}" class="m3-card m3-card-elevated" style="text-decoration: none; color: inherit; padding: 24px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); display: flex; flex-direction: column;" onmouseover="this.style.transform='translateY(-6px)'; this.style.boxShadow='0 20px 40px rgba(0,0,0,0.1)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 1px 2px rgba(0,0,0,0.3), 0 1px 3px 1px rgba(0,0,0,0.15)'">
                {% if post.featuredImage %}
                    <div style="width: calc(100% + 48px); margin: -24px -24px 20px -24px; height: 160px; overflow: hidden; border-radius: 24px 24px 0 0;">
                        <img src="{{ asset('uploads/forum/' ~ post.featuredImage) }}" alt="{{ post.title }}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                {% endif %}
                
                <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px;">
                    <span style="background: var(--m3-primary-container); padding: 6px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 700; color: var(--m3-on-primary-container); text-transform: uppercase; letter-spacing: 0.02em;">
                        {{ post.classe ? post.classe.name : 'General' }}
                    </span>
                    <span style="font-size: 0.8125rem; color: var(--m3-on-surface-variant); font-weight: 500;">
                        {{ post.createdAt|date('M d, Y') }}
                    </span>
                </div>
                
                <h2 style="margin: 0 0 12px 0; font-size: 1.375rem; font-weight: 600; line-height: 1.3; color: var(--m3-on-surface);">{{ post.title }}</h2>
                <p style="margin: 0 0 24px 0; color: var(--m3-on-surface-variant); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; flex-grow: 1; font-size: 0.9375rem;">
                    {{ post.content|striptags }}
                </p>

                <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 1px solid var(--m3-outline-variant);">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <div style="width: 36px; height: 36px; background: var(--m3-secondary-container); color: var(--m3-on-secondary-container); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.875rem; border: 1px solid var(--m3-outline-variant); overflow: hidden;">
                            {% if post.user.profile_picture %}
                                <img src="{{ asset('uploads/profiles/' ~ post.user.profile_picture) }}" style="width: 100%; height: 100%; object-fit: cover;">
                            {% else %}
                                {{ post.user.firstName|first|upper }}
                            {% endif %}
                        </div>
                        <div style="display: flex; flex-direction: column;">
                            <span style="font-size: 0.875rem; font-weight: 600; color: var(--m3-on-surface);">{{ post.user.firstName }} {{ post.user.lastName }}</span>
                            <span style="font-size: 0.75rem; color: var(--m3-on-surface-variant);">{{ post.user.roles|first|replace({'ROLE_': ''})|title }}</span>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 6px; color: var(--m3-primary); font-size: 0.875rem; font-weight: 600; background: var(--m3-surface-container-high); padding: 6px 12px; border-radius: 20px;">
                        <span>💬</span>
                        <span>{{ post.forumComments|length }}</span>
                    </div>
                </div>
            </a>
        {% else %}
            <div class="m3-card m3-card-outlined" style="text-align: center; padding: 80px; grid-column: 1 / -1; border-style: dashed; border-width: 2px;">
                <div style="font-size: 5rem; margin-bottom: 24px; filter: grayscale(1); opacity: 0.3;">💬</div>
                <h3 style="margin: 0 0 8px 0; font-size: 1.75rem; font-weight: 400; color: var(--m3-on-surface);">No discussions yet</h3>
                <p style="margin: 0; color: var(--m3-on-surface-variant); font-size: 1.1rem;">Be the first to share something with the community!</p>
                <div style="margin-top: 32px;">
                     <a href="{{ path('app_forum_new') }}" class="m3-button m3-button-filled" style="height: 48px; padding: 0 32px; border-radius: 12px;">
                        Start a Discussion
                    </a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
