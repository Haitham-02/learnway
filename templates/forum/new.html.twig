{% extends 'base.html.twig' %}

{% block title %}Start Discussion — LearnWay{% endblock %}

{% block body %}
<div style="padding-bottom: 64px;">
    
    <div style="display: flex; align-items: center; gap: 20px; margin-bottom: 40px;">
        <a href="{{ path('app_forum_index') }}" class="m3-button m3-button-outlined" style="border-radius: 50%; width: 48px; height: 48px; padding: 0; min-width: 48px; display: flex; align-items: center; justify-content: center;">
            <span style="font-size: 1.25rem;">←</span>
        </a>
        <div>
            <h1 style="margin: 0; font-size: 2.25rem; font-weight: 300; color: var(--m3-on-surface);">New <span style="font-weight: 700;">Discussion</span></h1>
            <p style="margin: 4px 0 0 0; color: var(--m3-on-surface-variant);">Start a conversation with the community.</p>
        </div>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: 12px; margin-bottom: 32px; border: 1px solid var(--m3-error);">
            <div style="font-weight: 700; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
                <span>⚠️</span> Please fix the following errors:
            </div>
            <ul style="margin: 0; padding-left: 24px;">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-elevated" style="padding: 40px; border-radius: 24px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 32px;">
            
            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="m3-label" style="font-weight: 700; color: var(--m3-primary); letter-spacing: 0.05em;">DISCUSSION TITLE</label>
                <input type="text" name="title" required class="m3-text-field" placeholder="What's on your mind?" value="{{ app.request.request.get('title') }}" style="font-size: 1.125rem; padding: 16px; border-radius: 12px;">
                <p style="margin: 4px 0 0 4px; font-size: 0.8125rem; color: var(--m3-on-surface-variant);">A clear title helps others find and join your discussion.</p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px;">
                <label class="m3-label" style="font-weight: 700; color: var(--m3-primary); letter-spacing: 0.05em;">CONTENT</label>
                <textarea name="content" required class="m3-text-field" rows="10" placeholder="Share your thoughts, questions, or ideas..." style="font-size: 1rem; padding: 16px; border-radius: 12px; line-height: 1.6;">{{ app.request.request.get('content') }}</textarea>
            </div>

            <div style="background: var(--m3-surface-container-low); padding: 24px; border-radius: 16px; border: 1px solid var(--m3-outline-variant); display: flex; gap: 20px; align-items: flex-start;">
                <div style="font-size: 2rem;">🛡️</div>
                <div>
                    <h4 style="margin: 0 0 4px 0; font-weight: 700; color: var(--m3-on-surface);">Moderation Policy</h4>
                    <p style="margin: 0; font-size: 0.875rem; color: var(--m3-on-surface-variant); line-height: 1.6;">
                        To maintain a positive learning environment, all posts are reviewed by administrators. 
                        Your post will be visible once it has been approved. Please avoid profanity and stay respectful.
                    </p>
                </div>
            </div>

            <div style="display: flex; gap: 16px; margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="flex: 2; height: 56px; font-size: 1.125rem; border-radius: 16px; font-weight: 600;">
                    Submit for Approval
                </button>
                <a href="{{ path('app_forum_index') }}" class="m3-button m3-button-outlined" style="flex: 1; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; font-weight: 600;">
                    Cancel
                </a>
            </div>
        </form>
    </div>
</div>
{% endblock %}
