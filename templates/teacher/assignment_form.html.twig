{% extends 'base.html.twig' %}
{% block title %}{{ assignment ? 'Edit' : 'New' }} Assignment{% endblock %}
{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('teacher_assignments', {subjectId: ta.subject.id, classId: ta.classe.id, chapterId: chapter.id}) }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">{{ assignment ? 'Edit' : 'New' }} Assignment</h1>
    </div>

    <p style="margin: -16px 0 32px 48px; color: var(--m3-on-surface-variant); font-size: 1rem;">
        Chapter: {{ chapter.title }} <span style="color: var(--m3-outline);">·</span> {{ ta.subject.name }} <span style="color: var(--m3-outline);">·</span> {{ ta.classe.name }}
    </p>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">{% for e in errors %}<li>{{ e }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <div>
                <label class="m3-label">TITLE *</label>
                <input type="text" name="title" required class="m3-text-field" value="{{ assignment ? assignment.title : app.request.request.get('title','') }}" placeholder="e.g. Weekly Quiz #1">
            </div>

            <div>
                <label class="m3-label">DESCRIPTION</label>
                <textarea name="description" rows="3" class="m3-text-field" style="resize: vertical;" placeholder="Add instructions for students...">{{ assignment ? assignment.description : app.request.request.get('description','') }}</textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">TYPE</label>
                    <select name="type" class="m3-select">
                        {% set currentType = assignment ? assignment.type : 'homework' %}
                        <option value="homework" {{ currentType == 'homework' ? 'selected' : '' }}>Homework</option>
                        <option value="quiz" {{ currentType == 'quiz' ? 'selected' : '' }}>Quiz</option>
                        <option value="exam" {{ currentType == 'exam' ? 'selected' : '' }}>Exam</option>
                    </select>
                </div>
                <div>
                    <label class="m3-label">SUBMISSION TYPE</label>
                    <select name="submission_type" class="m3-select">
                        {% set currentSub = assignment ? assignment.submissionType : 'TEXT' %}
                        <option value="TEXT" {{ currentSub == 'TEXT' ? 'selected' : '' }}>Text</option>
                        <option value="FILE" {{ currentSub == 'FILE' ? 'selected' : '' }}>File</option>
                        <option value="BOTH" {{ currentSub == 'BOTH' ? 'selected' : '' }}>Both</option>
                    </select>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">DUE DATE</label>
                    <input type="datetime-local" name="due_date" class="m3-text-field" value="{{ assignment and assignment.dueDate ? assignment.dueDate|date('Y-m-d\\TH:i') : '' }}">
                </div>
                <div>
                    <label class="m3-label">STATUS</label>
                    <select name="status" class="m3-select">
                        {% set currentStatus = assignment ? assignment.status : app.request.request.get('status', 'DRAFT') %}
                        <option value="DRAFT" {{ currentStatus == 'DRAFT' ? 'selected' : '' }}>Draft</option>
                        <option value="PUBLISHED" {{ currentStatus == 'PUBLISHED' ? 'selected' : '' }}>Published</option>
                        <option value="CLOSED" {{ currentStatus == 'CLOSED' ? 'selected' : '' }}>Closed</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="checkbox" name="allow_late_submission" id="allow_late" class="m3-checkbox" {{ assignment and assignment.isAllowLateSubmission ? 'checked' : '' }}>
                <label for="allow_late" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Allow late submissions</label>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    {{ assignment ? 'Save Changes' : 'Create Assignment' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
