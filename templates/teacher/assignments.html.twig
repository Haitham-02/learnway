{% extends 'base.html.twig' %}
{% block title %}Assignments: {{ chapter.title }}{% endblock %}
{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <div style="display: flex; flex-direction: column;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <a href="{{ path('teacher_chapters', {subjectId: ta.subject.id, classId: ta.classe.id}) }}" class="m3-button m3-button-outlined" style="border: none; padding: 0 12px; height: 32px;">
                    <span>←</span> Chapters
                </a>
            </div>
            <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">
                Assignments <span style="color: var(--m3-outline);">·</span> {{ chapter.title }}
            </h1>
        </div>
        <a href="{{ path('teacher_assignment_new', {subjectId: ta.subject.id, classId: ta.classe.id, chapterId: chapter.id}) }}" class="m3-button m3-button-filled">
            <span>+</span> New Assignment
        </a>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="display: flex; flex-direction: column; gap: 16px;">
        {% for a in assignments %}
            <div class="m3-card m3-card-elevated" style="display: flex; align-items: center; justify-content: space-between; padding: 20px 24px;">
                <div style="display: flex; flex-direction: column; gap: 4px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 1.125rem; font-weight: 500; color: var(--m3-on-surface);">{{ a.title }}</span>
                        <span style="font-size: 0.75rem; padding: 0 12px; height: 24px; display: flex; align-items: center; border-radius: var(--m3-radius-full); background-color: var(--m3-tertiary-container); color: var(--m3-on-tertiary-container); font-weight: 500;">
                            {{ a.type|capitalize }}
                        </span>
                        {% if a.status == 'PUBLISHED' %}
                            <span style="font-size: 0.75rem; padding: 0 12px; height: 24px; display: flex; align-items: center; border-radius: var(--m3-radius-full); background-color: var(--m3-primary-container); color: var(--m3-on-primary-container);">Published</span>
                        {% elseif a.status == 'CLOSED' %}
                            <span style="font-size: 0.75rem; padding: 0 12px; height: 24px; display: flex; align-items: center; border-radius: var(--m3-radius-full); background-color: var(--m3-error-container); color: var(--m3-on-error-container);">Closed</span>
                        {% else %}
                            <span style="font-size: 0.75rem; padding: 0 12px; height: 24px; display: flex; align-items: center; border-radius: var(--m3-radius-full); background-color: var(--m3-surface-variant); color: var(--m3-on-surface-variant);">Draft</span>
                        {% endif %}
                    </div>
                    <div style="font-size: 0.875rem; color: var(--m3-on-surface-variant);">
                        {% if a.dueDate %}Due: {{ a.dueDate|date('M d, Y H:i') }} <span style="color: var(--m3-outline);">·</span> {% endif %}{{ a.submissionType ?? 'TEXT' }}
                    </div>
                </div>
                <a href="{{ path('teacher_assignment_edit', {subjectId: ta.subject.id, classId: ta.classe.id, chapterId: chapter.id, assignmentId: a.id}) }}" class="m3-button m3-button-outlined">
                    Edit
                </a>
            </div>
        {% else %}
            <div class="m3-card m3-card-outlined" style="text-align: center; padding: 64px;">
                <p style="font-size: 1.1rem; color: var(--m3-on-surface-variant);">No assignments yet. Create your first assignment!</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
