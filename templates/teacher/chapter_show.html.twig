{% extends 'base.html.twig' %}

{% block title %}{{ chapter.title }} — Teacher{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    {# Header Section #}
    <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 40px; background: var(--m3-surface-container-low); padding: 32px; border-radius: var(--m3-radius-large);">
        <div style="display: flex; flex-direction: column; gap: 8px;">
            <div style="display: flex; align-items: center; gap: 12px;">
                <a href="{{ path('teacher_chapters', {subjectId: ta.subject.id, classId: ta.classe.id}) }}" class="m3-button m3-button-tonal" style="padding: 0 12px; height: 32px;">
                    <span>←</span> Chapters
                </a>
                <span style="color: var(--m3-outline); font-size: 0.875rem;">{{ ta.subject.name }} · {{ ta.classe.name }}</span>
            </div>
            <h1 style="margin: 0; font-size: 2.5rem; font-weight: 400; color: var(--m3-on-surface);">{{ chapter.title }}</h1>
            {% if chapter.description %}
                <p style="margin: 0; color: var(--m3-on-surface-variant); max-width: 800px; line-height: 1.6;">{{ chapter.description }}</p>
            {% endif %}
            <div style="display: flex; align-items: center; gap: 16px; margin-top: 12px;">
                {% if chapter.isPublished %}
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: var(--m3-primary-container); color: var(--m3-on-primary-container); border-radius: var(--m3-radius-full); font-size: 0.875rem; font-weight: 500;">
                        <span style="width: 8px; height: 8px; background: currentColor; border-radius: 50%;"></span> Published
                    </span>
                {% else %}
                    <span style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: var(--m3-surface-variant); color: var(--m3-on-surface-variant); border-radius: var(--m3-radius-full); font-size: 0.875rem; font-weight: 500;">
                        <span style="width: 8px; height: 8px; background: currentColor; border-radius: 50%;"></span> Draft
                    </span>
                {% endif %}
                <span style="color: var(--m3-outline); font-size: 0.875rem;">Order: {{ chapter.sortOrder }}</span>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('teacher_chapter_edit', {subjectId: ta.subject.id, classId: ta.classe.id, chapterId: chapter.id}) }}" class="m3-button m3-button-outlined">
                Edit Settings
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 32px;">
            {{ message }}
        </div>
    {% endfor %}

    {# Main Grid #}
    <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 32px;">
        
        {# Left Column: Resources #}
        <div style="display: flex; flex-direction: column; gap: 32px;">
            
            {# Text Content Blocks #}
            <section>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 400; color: var(--m3-on-surface);">Text Content</h2>
                    <a href="{{ path('teacher_chapter_content_add', {chapterId: chapter.id}) }}" class="m3-button m3-button-tonal">
                        <span>+</span> Add Text
                    </a>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    {% for content in chapter.chapterContents %}
                        <div class="m3-card m3-card-outlined" style="padding: 24px;">
                            <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 12px;">
                                <h3 style="margin: 0; font-size: 1.125rem; font-weight: 500; color: var(--m3-on-surface);">{{ content.title ?: 'Untitled Content' }}</h3>
                                <div style="display: flex; gap: 8px;">
                                    <a href="{{ path('teacher_chapter_content_edit', {chapterId: chapter.id, contentId: content.id}) }}" style="color: var(--m3-primary); text-decoration: none; font-size: 0.875rem; font-weight: 500;">Edit</a>
                                    <form method="post" action="{{ path('teacher_chapter_content_delete', {chapterId: chapter.id, contentId: content.id}) }}" style="display: inline;" onsubmit="return confirm('Delete this content?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_content_' ~ content.id) }}">
                                        <button type="submit" style="background: none; border: none; color: var(--m3-error); font-size: 0.875rem; font-weight: 500; cursor: pointer;">Delete</button>
                                    </form>
                                </div>
                            </div>
                            <div style="color: var(--m3-on-surface-variant); line-height: 1.6; white-space: pre-wrap;">{{ content.body }}</div>
                        </div>
                    {% else %}
                        <div style="padding: 40px; border: 1px dashed var(--m3-outline); border-radius: var(--m3-radius-medium); text-align: center; color: var(--m3-on-surface-variant);">
                            No text content yet.
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# Assignments #}
            <section>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 400; color: var(--m3-on-surface);">Assignments</h2>
                    <a href="{{ path('teacher_assignment_new', {subjectId: ta.subject.id, classId: ta.classe.id, chapterId: chapter.id}) }}" class="m3-button m3-button-tonal">
                        <span>+</span> New Assignment
                    </a>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 16px;">
                    {% for assignment in chapter.assignments %}
                        <div class="m3-card m3-card-outlined" style="display: flex; align-items: center; justify-content: space-between; padding: 16px 24px;">
                            <div style="display: flex; align-items: center; gap: 16px;">
                                <div style="width: 40px; height: 40px; background: var(--m3-secondary-container); color: var(--m3-on-secondary-container); display: flex; align-items: center; justify-content: center; border-radius: var(--m3-radius-small); font-size: 1.25rem;">📝</div>
                                <div>
                                    <h3 style="margin: 0; font-size: 1rem; font-weight: 500;">{{ assignment.title }}</h3>
                                    <span style="font-size: 0.875rem; color: var(--m3-on-surface-variant);">Due: {{ assignment.dueDate ? assignment.dueDate|date('M d, Y') : 'No date' }}</span>
                                </div>
                            </div>
                            <a href="{{ path('teacher_submissions', {assignmentId: assignment.id}) }}" class="m3-button m3-button-outlined" style="height: 32px; font-size: 0.875rem;">View Submissions</a>
                        </div>
                    {% else %}
                        <div style="padding: 40px; border: 1px dashed var(--m3-outline); border-radius: var(--m3-radius-medium); text-align: center; color: var(--m3-on-surface-variant);">
                            No assignments linked to this chapter.
                        </div>
                    {% endfor %}
                </div>
            </section>

            {# Chapter Items (Generic) #}
            <section>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
                    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 400; color: var(--m3-on-surface);">Generic Items</h2>
                    <form action="{{ path('teacher_chapter_item_add', {chapterId: chapter.id}) }}" method="post" style="display: flex; gap: 8px;">
                        <input type="text" name="type" placeholder="Item Type (e.g. Link)" required class="m3-text-field" style="height: 32px; font-size: 0.875rem; width: 150px;">
                        <button type="submit" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 12px;">Add</button>
                    </form>
                </div>
                
                <div style="display: flex; flex-direction: column; gap: 12px;">
                    {% for item in chapter.chapterItems %}
                        <div class="m3-card m3-card-outlined" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 24px; background: var(--m3-surface-container-lowest);">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <span style="font-size: 0.875rem; font-weight: 500; color: var(--m3-secondary);">{{ item.type }}</span>
                                <span style="color: var(--m3-outline); font-size: 0.75rem;">Sort: {{ item.sortOrder }}</span>
                            </div>
                            <form method="post" action="{{ path('teacher_chapter_item_delete', {chapterId: chapter.id, itemId: item.id}) }}" onsubmit="return confirm('Delete this item?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_item_' ~ item.id) }}">
                                <button type="submit" style="background: none; border: none; color: var(--m3-error); font-size: 0.875rem; cursor: pointer;">Delete</button>
                            </form>
                        </div>
                    {% else %}
                        <div style="padding: 24px; border: 1px dashed var(--m3-outline); border-radius: var(--m3-radius-medium); text-align: center; color: var(--m3-on-surface-variant); font-size: 0.875rem;">
                            No generic items.
                        </div>
                    {% endfor %}
                </div>
            </section>

        </div>

        {# Right Column: Files & Metadata #}
        <div style="display: flex; flex-direction: column; gap: 32px;">
            
            {# File Uploads #}
            <section class="m3-card m3-card-filled" style="padding: 24px; background: var(--m3-surface-container-high);">
                <h2 style="margin: 0 0 20px 0; font-size: 1.25rem; font-weight: 500; color: var(--m3-on-surface);">Resources & Files</h2>
                
                <form action="{{ path('teacher_chapter_file_add', {chapterId: chapter.id}) }}" method="post" enctype="multipart/form-data" style="margin-bottom: 24px;">
                    <label class="m3-button m3-button-filled" style="width: 100%; cursor: pointer; height: auto; padding: 12px; display: flex; flex-direction: column; gap: 4px;">
                        <span>Upload File</span>
                        <span style="font-size: 0.75rem; opacity: 0.8; font-weight: 400;">PDF, Doc, Images...</span>
                        <input type="file" name="file" onchange="this.form.submit()" style="display: none;">
                    </label>
                </form>

                <div style="display: flex; flex-direction: column; gap: 12px;">
                    {% for file in chapter.chapterFiles %}
                        {% set mime = file.fileType|default('') %}
                        {% set previewable = mime starts with 'image/' or mime == 'application/pdf' or mime starts with 'video/' or mime starts with 'audio/' or mime starts with 'text/' %}
                        <div style="padding: 12px; background: var(--m3-surface); border-radius: var(--m3-radius-small); border: 1px solid var(--m3-outline-variant);">
                            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
                                <div style="display: flex; align-items: center; gap: 12px; min-width: 0;">
                                    <div style="font-size: 1.25rem;">📄</div>
                                    <div style="min-width: 0;">
                                        <div style="font-size: 0.875rem; font-weight: 500; color: var(--m3-on-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="{{ file.fileName }}">
                                            {{ file.fileName }}
                                        </div>
                                        <div style="font-size: 0.75rem; color: var(--m3-on-surface-variant);">{{ (file.fileSize / 1024)|number_format(1) }} KB</div>
                                    </div>
                                </div>
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <a href="{{ file.filePath }}" target="_blank" class="m3-button m3-button-tonal" style="height: 30px; min-width: 56px; padding: 0 10px; font-size: 0.75rem;">View</a>
                                    <a href="{{ file.filePath }}" download class="m3-button m3-button-outlined" style="height: 30px; min-width: 74px; padding: 0 10px; font-size: 0.75rem;">Download</a>
                                    <form method="post" action="{{ path('teacher_chapter_file_delete', {chapterId: chapter.id, fileId: file.id}) }}" onsubmit="return confirm('Delete this file?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_file_' ~ file.id) }}">
                                        <button type="submit" style="background: none; border: none; color: var(--m3-error); padding: 4px; cursor: pointer; font-size: 1rem;">×</button>
                                    </form>
                                </div>
                            </div>

                            {% if previewable %}
                                <details style="margin-top: 10px;">
                                    <summary style="cursor: pointer; color: var(--m3-primary); font-size: 0.8125rem; font-weight: 500;">Preview in page</summary>
                                    <div style="margin-top: 8px; border: 1px solid var(--m3-outline-variant); border-radius: 10px; overflow: hidden;">
                                        {% if mime starts with 'image/' %}
                                            <img src="{{ file.filePath }}" alt="{{ file.fileName }}" style="width: 100%; display: block;">
                                        {% elseif mime == 'application/pdf' %}
                                            <iframe src="{{ file.filePath }}" title="{{ file.fileName }}" style="width: 100%; height: min(80vh, 920px); min-height: 620px; border: 0;"></iframe>
                                        {% elseif mime starts with 'video/' %}
                                            <video controls style="width: 100%; max-height: min(80vh, 920px); min-height: 500px;">
                                                <source src="{{ file.filePath }}" type="{{ mime }}">
                                            </video>
                                        {% elseif mime starts with 'audio/' %}
                                            <div style="padding: 12px;">
                                                <audio controls style="width: 100%;">
                                                    <source src="{{ file.filePath }}" type="{{ mime }}">
                                                </audio>
                                            </div>
                                        {% else %}
                                            <iframe src="{{ file.filePath }}" title="{{ file.fileName }}" style="width: 100%; height: min(74vh, 860px); min-height: 560px; border: 0;"></iframe>
                                        {% endif %}
                                    </div>
                                </details>
                            {% endif %}
                        </div>
                    {% else %}
                        <p style="text-align: center; color: var(--m3-on-surface-variant); font-size: 0.875rem; margin: 20px 0;">No files uploaded.</p>
                    {% endfor %}
                </div>
            </section>

        </div>

    </div>
</div>
{% endblock %}
