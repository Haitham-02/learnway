{% extends 'base.html.twig' %}

{% block title %}Review Submission — {{ assignment.title }}{% endblock %}

{% block body %}
<div style="max-width: 1000px; margin: 0 auto; padding-bottom: 64px;">
    
    <div style="margin-bottom: 32px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <a href="{{ path('teacher_submissions', {assignmentId: assignment.id}) }}" class="m3-button m3-button-text" style="padding: 0; height: 32px; font-size: 0.875rem;">
                ← Back to Submissions
            </a>
        </div>
        <div style="display: flex; align-items: center; justify-content: space-between;">
            <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Review: {{ submission.student.firstName }} {{ submission.student.lastName }}</h1>
            <div style="padding: 8px 16px; border-radius: 12px; font-weight: 600; font-size: 0.875rem; 
                {% if submission.status == 'graded' %}
                    background: #dcfce7; color: #166534;
                {% else %}
                    background: #e0e7ff; color: #3730a3;
                {% endif %}">
                {{ submission.status|title }}
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr; gap: 32px;">
        
        {# ── STUDENT SUBMISSION ── #}
        <section class="m3-card m3-card-outlined" style="padding: 32px; border-radius: 24px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--m3-outline-variant);">
                <div>
                    <h2 style="margin: 0 0 4px 0; font-size: 1.25rem; font-weight: 500;">Submitted Work</h2>
                    <span style="font-size: 0.875rem; color: var(--m3-on-surface-variant);">Submitted on {{ submission.submittedAt ? submission.submittedAt|date('M d, Y · H:i') : 'Unknown' }}</span>
                </div>
            </div>

            {% if submission.submissionText %}
                <div style="margin-bottom: 24px;">
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--m3-outline); font-weight: 600; margin-bottom: 8px;">Response Text</div>
                    <div style="background: var(--m3-surface-container-low); padding: 24px; border-radius: 16px; white-space: pre-wrap; line-height: 1.6;">{{ submission.submissionText }}</div>
                </div>
            {% endif %}

            {% if submission.submissionFiles|length > 0 %}
                <div>
                    <div style="font-size: 0.75rem; text-transform: uppercase; color: var(--m3-outline); font-weight: 600; margin-bottom: 8px;">Attached Files</div>
                    <div style="display: flex; flex-direction: column; gap: 8px;">
                        {% for file in submission.submissionFiles %}
                            <div style="display: flex; align-items: center; justify-content: space-between; padding: 12px 20px; background: var(--m3-surface-container-low); border-radius: 12px;">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <span>📄</span>
                                    <span style="font-size: 0.9375rem;">{{ file.fileName }}</span>
                                    <span style="font-size: 0.75rem; color: var(--m3-on-surface-variant);">({{ (file.fileSize / 1024)|number_format(1) }} KB)</span>
                                </div>
                                <a href="{{ file.filePath }}" class="m3-button m3-button-text" target="_blank">Download</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}
            
            {% if not submission.submissionText and submission.submissionFiles|length == 0 %}
                <div style="text-align: center; color: var(--m3-on-surface-variant); padding: 24px;">
                    This submission is completely empty.
                </div>
            {% endif %}
        </section>

        {# ── GRADING & FEEDBACK FORM ── #}
        <section class="m3-card m3-card-filled" style="padding: 32px; border-radius: 24px; background: white; border: 2px solid var(--m3-primary);">
            <h2 style="margin: 0 0 24px 0; font-size: 1.25rem; font-weight: 500;">Provide Feedback</h2>
            
            <form action="{{ path('teacher_submission_review', {submissionId: submission.id}) }}" method="post">
                <div style="display: flex; flex-direction: column; gap: 24px;">
                    
                    <div>
                        <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 8px;">Instructor Feedback</label>
                        <textarea name="feedback" rows="6" class="m3-text-field" style="width: 100%; border-radius: 12px; padding: 16px;" placeholder="Write your feedback to the student here...">{{ submission.feedback }}</textarea>
                    </div>

                    <div>
                        <label style="display: block; font-size: 0.875rem; font-weight: 600; margin-bottom: 8px;">Status</label>
                        <select name="status" class="m3-text-field" style="width: 100%; border-radius: 12px; height: 48px; padding: 0 16px;">
                            <option value="graded" {% if submission.status == 'graded' %}selected{% endif %}>Graded / Complete</option>
                            <option value="returned" {% if submission.status == 'returned' %}selected{% endif %}>Returned for Revision</option>
                            <option value="submitted" {% if submission.status == 'submitted' %}selected{% endif %}>Keep as Submitted (No grade yet)</option>
                        </select>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <button type="submit" class="m3-button m3-button-filled" style="height: 56px; padding: 0 40px; border-radius: 16px; font-size: 1rem;">
                            Save Review
                        </button>
                    </div>
                </div>
            </form>
        </section>

    </div>
</div>
{% endblock %}
