{% extends 'base.html.twig' %}

{% block title %}{{ chapter ? 'Edit Chapter' : 'New Chapter' }} — Teacher{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('teacher_chapters', {subjectId: ta.subject.id, classId: ta.classe.id}) }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">{{ chapter ? 'Edit Chapter' : 'New Chapter' }}</h1>
    </div>

    <p style="margin: -16px 0 32px 48px; color: var(--m3-on-surface-variant); font-size: 1rem;">
        {{ ta.subject.name }} <span style="color: var(--m3-outline);">·</span> {{ ta.classe.name }}
    </p>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <div>
                <label class="m3-label">TITLE *</label>
                <input type="text" name="title" required class="m3-text-field" value="{{ chapter ? chapter.title : app.request.request.get('title', '') }}" placeholder="e.g. Introduction to Algebra">
            </div>

            <div>
                <label class="m3-label">DESCRIPTION</label>
                <textarea name="description" rows="4" class="m3-text-field" style="resize: vertical;" placeholder="Briefly describe the chapter content...">{{ chapter ? chapter.description : app.request.request.get('description', '') }}</textarea>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: center;">
                <div>
                    <label class="m3-label">SORT ORDER</label>
                    <input type="number" name="sort_order" class="m3-text-field" value="{{ chapter ? chapter.sortOrder : app.request.request.get('sort_order', '0') }}">
                </div>
                <div style="display: flex; align-items: center; gap: 12px; margin-top: 24px;">
                    <input type="checkbox" name="is_published" id="is_published" class="m3-checkbox" {{ (chapter and chapter.isPublished) or (not chapter and app.request.method == 'GET') or app.request.request.has('is_published') ? 'checked' : '' }}>
                    <label for="is_published" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Published</label>
                </div>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    {{ chapter ? 'Save Changes' : 'Create Chapter' }}
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
