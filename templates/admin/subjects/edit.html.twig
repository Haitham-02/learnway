{% extends 'base.html.twig' %}

{% block title %}Edit Subject — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_subjects_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Edit Subject</h1>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">SUBJECT CODE</label>
                    <input type="text" name="subject_code" required value="{{ app.request.isMethod('POST') ? app.request.request.get('subject_code') : subject.subjectCode }}" class="m3-text-field" placeholder="e.g. MATH101">
                </div>
                <div>
                    <label class="m3-label">SUBJECT NAME</label>
                    <input type="text" name="name" required value="{{ app.request.isMethod('POST') ? app.request.request.get('name') : subject.name }}" class="m3-text-field" placeholder="e.g. Mathematics">
                </div>
            </div>

            <div>
                <label class="m3-label">ASSIGNED TERM</label>
                <select name="term_id" class="m3-select">
                    <option value="">— Select a term —</option>
                    {% set currentTermId = app.request.isMethod('POST') ? app.request.request.get('term_id') : (subject.term ? subject.term.id : '') %}
                    {% for term in terms %}
                        <option value="{{ term.id }}" {{ currentTermId == term.id ? 'selected' : '' }}>
                            {{ term.displayName }}
                        </option>
                    {% endfor %}
                </select>
                <p style="margin: 4px 0 0; font-size: 0.75rem; color: var(--m3-on-surface-variant);">Assigning a term helps organize curriculum by academic periods.</p>
            </div>

            <div>
                <label class="m3-label">GRADE LEVEL</label>
                <input type="text" name="grade_level" value="{{ app.request.isMethod('POST') ? app.request.request.get('grade_level') : (subject.gradeLevel ?: '') }}" class="m3-text-field" placeholder="e.g. Grade 7">
                <p style="margin: 4px 0 0; font-size: 0.75rem; color: var(--m3-on-surface-variant);">Classes of this grade level will be offered this subject.</p>
            </div>

            <div>
                <label class="m3-label">DESCRIPTION</label>
                <textarea name="description" rows="4" class="m3-text-field" style="height: auto; padding: 12px 16px;" placeholder="Brief overview of the subject curriculum...">{{ app.request.isMethod('POST') ? app.request.request.get('description') : subject.description }}</textarea>
            </div>

            {% set isActiveChecked = app.request.isMethod('POST') ? app.request.request.get('is_active') : subject.isActive %}
            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="checkbox" name="is_active" id="is_active" value="1" {% if isActiveChecked %}checked{% endif %} class="m3-checkbox">
                <label for="is_active" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Active Subject</label>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
