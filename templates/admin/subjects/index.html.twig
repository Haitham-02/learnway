{% extends 'base.html.twig' %}

{% block title %}Subjects — Admin{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Subject Management</h1>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_dashboard') }}" class="m3-button m3-button-outlined">
                ← Dashboard
            </a>
            <a href="{{ path('admin_subjects_new') }}" class="m3-button m3-button-filled">
                + Add Subject
            </a>
        </div>
    </div>

    {# Filters #}
    <div class="m3-card m3-card-outlined" style="padding: 20px 24px; margin-bottom: 24px;">
        <form method="get" id="filterForm" style="display: flex; flex-direction: column; gap: 16px;">
            <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; align-items: flex-end;">
                <div>
                    <label class="m3-label" style="margin-bottom: 4px;">ACADEMIC YEAR</label>
                    <select name="academic_year_id" class="m3-select" onchange="document.getElementById('filterForm').querySelector('[name=term_id]').value=''; this.form.submit()">
                        <option value="">All Years</option>
                        {% for ay in academic_years %}
                            <option value="{{ ay.id }}" {{ current_academic_year == ay.id ? 'selected' : '' }}>
                                {{ ay.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="m3-label" style="margin-bottom: 4px;">TERM</label>
                    <select name="term_id" class="m3-select" onchange="this.form.submit()">
                        <option value="">All Terms</option>
                        {% for term in terms %}
                            <option value="{{ term.id }}" {{ current_term == term.id ? 'selected' : '' }}>
                                {{ term.name }}{% if not current_academic_year %} ({{ term.academicYear.name }}){% endif %}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="m3-label" style="margin-bottom: 4px;">CLASS</label>
                    <select name="class_id" class="m3-select" onchange="this.form.submit()">
                        <option value="">All Classes</option>
                        {% for classe in classes %}
                            <option value="{{ classe.id }}" {{ current_class == classe.id ? 'selected' : '' }}>
                                {{ classe.name }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="m3-label" style="margin-bottom: 4px;">SEARCH</label>
                    <div style="display: flex; gap: 8px;">
                        <input type="text" name="search" class="m3-text-field" value="{{ current_search }}" placeholder="Name or code..." style="flex-grow: 1;">
                        <button type="submit" class="m3-button m3-button-tonal" style="height: 48px; padding: 0 16px; border-radius: var(--m3-radius-small); white-space: nowrap;">
                            🔍
                        </button>
                    </div>
                </div>
            </div>
            {% if current_term or current_academic_year or current_class or current_search %}
                <div style="display: flex; align-items: center; gap: 8px; padding-top: 4px; border-top: 1px solid var(--m3-outline-variant);">
                    <span style="font-size: 0.75rem; color: var(--m3-on-surface-variant); text-transform: uppercase; font-weight: 600;">Active filters:</span>
                    {% if current_academic_year %}
                        {% for ay in academic_years %}
                            {% if ay.id == current_academic_year %}
                                <span style="background: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 500;">Year: {{ ay.name }}</span>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if current_term %}
                        {% for term in terms %}
                            {% if term.id == current_term %}
                                <span style="background: var(--m3-secondary-container); color: var(--m3-on-secondary-container); padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 500;">Term: {{ term.name }}</span>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if current_class %}
                        {% for classe in classes %}
                            {% if classe.id == current_class %}
                                <span style="background: var(--m3-tertiary-container); color: var(--m3-on-tertiary-container); padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 500;">Class: {{ classe.name }}</span>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                    {% if current_search %}
                        <span style="background: var(--m3-surface-variant); color: var(--m3-on-surface-variant); padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 500;">Search: "{{ current_search }}"</span>
                    {% endif %}
                    <a href="{{ path('admin_subjects_index') }}" class="m3-button m3-button-text" style="height: 28px; font-size: 0.75rem; padding: 0 8px; margin-left: auto; color: var(--m3-error);">
                        ✕ Clear All
                    </a>
                </div>
            {% endif %}
        </form>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="m3-card m3-card-outlined" style="padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead style="background-color: var(--m3-surface-container-low);">
                <tr>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">CODE</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">NAME</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">TERM</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">GRADE</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">STATUS</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% for subject in subjects %}
                <tr style="border-bottom: 1px solid var(--m3-surface-container-high); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--m3-surface-container-low)'" onmouseout="this.style.backgroundColor='transparent'">
                    <td style="padding: 16px 24px; font-weight: 500; color: var(--m3-primary);">{{ subject.subjectCode }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface);">{{ subject.name }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">
                        {% if subject.term %}
                            <span style="display: flex; flex-direction: column;">
                                <span style="font-weight: 500;">{{ subject.term.name }}</span>
                                <span style="font-size: 0.75rem; color: var(--m3-outline);">{{ subject.term.academicYear.name }}</span>
                            </span>
                        {% else %}
                            <span style="color: var(--m3-outline);">—</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ subject.gradeLevel ?: '—' }}</td>
                    <td style="padding: 16px 24px;">
                        {% if subject.isActive %}
                            <span style="color: var(--m3-primary); display: flex; align-items: center; gap: 4px;">● Active</span>
                        {% else %}
                            <span style="color: var(--m3-outline); display: flex; align-items: center; gap: 4px;">○ Inactive</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 24px;">
                        <div style="display: flex; gap: 8px;">
                            <a href="{{ path('admin_subjects_edit', {id: subject.id}) }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 12px;">
                                Edit
                            </a>
                            <form method="post" action="{{ path('admin_subjects_delete', {id: subject.id}) }}" onsubmit="return confirm('Delete subject?');" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_subject_' ~ subject.id) }}">
                                <button type="submit" class="m3-button" style="height: 32px; padding: 0 12px; background: transparent; border: 1px solid var(--m3-error); color: var(--m3-error);">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="6" style="padding: 48px; text-align: center; color: var(--m3-outline);">No subjects found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
