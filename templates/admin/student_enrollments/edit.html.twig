{% extends 'base.html.twig' %}

{% block title %}Edit Student Enrollment — Admin{% endblock %}

{% block body %}
<div style="max-width:560px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;">
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <a href="{{ path('admin_student_enrollments_index') }}" style="color:#6b7280;text-decoration:none;font-size:.9rem;">← Back to Enrollments</a>
        <h1 style="margin:0;font-size:1.5rem;">Edit Student Enrollment #{{ enrollment.id }}</h1>
    </div>

    {% if errors is not empty %}
        <div style="background:#fee2e2;color:#b91c1c;padding:.75rem 1rem;border-radius:6px;margin-bottom:1.25rem;">
            <ul style="margin:0;padding-left:1.25rem;">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    {% set selectedClass = app.request.isMethod('POST') ? app.request.request.get('class_id') : (enrollment.classe ? enrollment.classe.id : '') %}
    {% set selectedUser = app.request.isMethod('POST') ? app.request.request.get('user_id') : (enrollment.user ? enrollment.user.id : '') %}
    {% set enrolledAt = app.request.isMethod('POST') ? app.request.request.get('enrolled_at') : (enrollment.enrolledAt ? enrollment.enrolledAt|date('Y-m-d') : '') %}
    {% set leftAt = app.request.isMethod('POST') ? app.request.request.get('left_at') : (enrollment.leftAt ? enrollment.leftAt|date('Y-m-d') : '') %}

    <div style="background:#fff;padding:2rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);">
        <form method="post" novalidate>
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Class</label>
                <select name="class_id" required style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;background:#fff;">
                    <option value="">— Select class —</option>
                    {% for class in classes %}
                        <option value="{{ class.id }}" {% if selectedClass == class.id %}selected{% endif %}>{{ class.name }} ({{ class.gradeLevel }})</option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Student</label>
                <select name="user_id" required style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;background:#fff;">
                    <option value="">— Select student —</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {% if selectedUser == user.id %}selected{% endif %}>{{ user.firstName }} {{ user.lastName }} ({{ user.role ? user.role.name : '—' }}) — {{ user.email }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
                <div>
                    <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Enrolled At</label>
                    <input type="date" name="enrolled_at" required value="{{ enrolledAt }}" style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
                </div>
                <div>
                    <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Left At (optional)</label>
                    <input type="date" name="left_at" value="{{ leftAt }}" style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;box-sizing:border-box;">
                </div>
            </div>

            <button type="submit" style="width:100%;padding:.75rem;background:#2563eb;color:#fff;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;">Save Changes</button>
        </form>
    </div>
</div>
{% endblock %}
