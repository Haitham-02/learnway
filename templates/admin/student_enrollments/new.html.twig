{% extends 'base.html.twig' %}

{% block title %}Add Student Enrollment — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_student_enrollments_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Add Enrollment</h1>
        <div style="margin-left: auto; display: flex; gap: 8px;">
            <a href="{{ path('admin_classes_new', { return_to: app.request.uri }) }}" class="m3-button m3-button-text" style="font-size: 0.875rem;">+ Class</a>
            <a href="{{ path('admin_users_new', { return_to: app.request.uri }) }}" class="m3-button m3-button-text" style="font-size: 0.875rem;">+ Student</a>
        </div>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <input type="hidden" name="return_to" value="{{ app.request.query.get('return_to', '') }}">

            <div>
                <label class="m3-label">CLASS *</label>
                <select name="class_id" required class="m3-select">
                    <option value="">— Select class —</option>
                    {% for class in classes %}
                        <option value="{{ class.id }}" {% if app.request.get('class_id') == class.id %}selected{% endif %}>{{ class.name }} ({{ class.gradeLevel }})</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="m3-label">STUDENT *</label>
                <select name="user_id" required class="m3-select">
                    <option value="">— Select student —</option>
                    {% for user in users %}
                        <option value="{{ user.id }}" {% if app.request.get('user_id') == user.id %}selected{% endif %}>{{ user.firstName }} {{ user.lastName }} ({{ user.role ? user.role.name : '—' }}) — {{ user.email }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="m3-label">ACADEMIC YEAR *</label>
                <select name="academic_year_id" required class="m3-select">
                    <option value="">— Select academic year —</option>
                    {% for year in academicYears %}
                        <option value="{{ year.id }}" {% if app.request.get('academic_year_id') == year.id %}selected{% endif %}>{{ year.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Create Enrollment
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
