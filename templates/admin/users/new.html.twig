{% extends 'base.html.twig' %}

{% block title %}Add User — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_users_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Add User</h1>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <input type="hidden" name="return_to" value="{{ app.request.query.get('return_to', '') }}">

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">FIRST NAME</label>
                    <input type="text" name="first_name" required class="m3-text-field" placeholder="e.g. Haitham">
                </div>
                <div>
                    <label class="m3-label">LAST NAME</label>
                    <input type="text" name="last_name" required class="m3-text-field" placeholder="e.g. Harzallah">
                </div>
            </div>

            <div>
                <label class="m3-label">EMAIL ADDRESS</label>
                <input type="email" name="email" required class="m3-text-field" placeholder="e.g. haitham@learnway.com">
            </div>

            <div>
                <label class="m3-label">PASSWORD</label>
                <input type="password" name="password" required minlength="8" class="m3-text-field" placeholder="••••••••">
                <p style="margin: 4px 0 0; font-size: 0.75rem; color: var(--m3-on-surface-variant);">Minimum 8 characters.</p>
            </div>

            <div>
                <label class="m3-label">ROLE</label>
                <select name="role_id" required class="m3-select">
                    <option value="">— Select a role —</option>
                    {% for role in roles %}
                        <option value="{{ role.id }}">{{ role.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="checkbox" name="is_active" id="is_active" value="1" checked class="m3-checkbox">
                <label for="is_active" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Active User</label>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Create User
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
