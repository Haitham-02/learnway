{% extends 'base.html.twig' %}

{% block title %}Users — Admin{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">User Management</h1>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_dashboard') }}" class="m3-button m3-button-outlined">
                ← Dashboard
            </a>
            <a href="{{ path('admin_users_new') }}" class="m3-button m3-button-filled">
                + Add User
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="m3-card m3-card-outlined" style="padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead style="background-color: var(--m3-surface-container-low);">
                <tr>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">#</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">NAME</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">EMAIL</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">ROLE</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">STATUS</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">CREATED</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
                {% for user in users %}
                <tr style="border-bottom: 1px solid var(--m3-surface-container-high); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--m3-surface-container-low)'" onmouseout="this.style.backgroundColor='transparent'">
                    <td style="padding: 16px 24px; color: var(--m3-outline);">{{ user.id }}</td>
                    <td style="padding: 16px 24px; font-weight: 500; color: var(--m3-on-surface);">{{ user.firstName }} {{ user.lastName }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ user.email }}</td>
                    <td style="padding: 16px 24px;">
                        {% set roleColor = user.role and user.role.name == 'ADMIN' ? 'var(--m3-error)' : (user.role and user.role.name == 'TEACHER' ? 'var(--m3-primary)' : 'var(--m3-secondary)') %}
                        <span style="padding: 4px 12px; border-radius: var(--m3-radius-full); font-size: 0.75rem; font-weight: 500; border: 1px solid {{ roleColor }}; color: {{ roleColor }};">
                            {{ user.role ? user.role.name : '—' }}
                        </span>
                    </td>
                    <td style="padding: 16px 24px;">
                        {% if user.isActive %}
                            <span style="color: var(--m3-primary); display: flex; align-items: center; gap: 4px;">● Active</span>
                        {% else %}
                            <span style="color: var(--m3-outline); display: flex; align-items: center; gap: 4px;">○ Inactive</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">
                        {{ user.createdAt ? user.createdAt|date('Y-m-d') : '—' }}
                    </td>
                    <td style="padding: 16px 24px;">
                        <div style="display: flex; gap: 8px;">
                            <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 12px;">
                                Edit
                            </a>
                            {% if user.id != app.user.id %}
                            <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" onsubmit="return confirm('Delete user?');" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_user_' ~ user.id) }}">
                                <button type="submit" class="m3-button" style="height: 32px; padding: 0 12px; background: transparent; border: 1px solid var(--m3-error); color: var(--m3-error);">
                                    Delete
                                </button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="7" style="padding: 48px; text-align: center; color: var(--m3-outline);">No users found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
