{% extends 'base.html.twig' %}

{% block title %}Edit Forum Post — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_forum_posts_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Edit Forum Post</h1>
        <div style="margin-left: auto; display: flex; gap: 8px;">
            <a href="{{ path('admin_classes_new', { return_to: app.request.uri }) }}" class="m3-button m3-button-text" style="font-size: 0.875rem;">+ Class</a>
            <a href="{{ path('admin_users_new', { return_to: app.request.uri }) }}" class="m3-button m3-button-text" style="font-size: 0.875rem;">+ Author</a>
        </div>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    {% set selectedClass = app.request.isMethod('POST') ? app.request.request.get('class_id') : (post.classe ? post.classe.id : '') %}
    {% set selectedUser = app.request.isMethod('POST') ? app.request.request.get('user_id') : (post.user ? post.user.id : '') %}
    {% set title = app.request.isMethod('POST') ? app.request.request.get('title') : post.title %}
    {% set subtitle = app.request.isMethod('POST') ? app.request.request.get('subtitle') : (post.subtitle ?: '') %}
    {% set description = app.request.isMethod('POST') ? app.request.request.get('description') : (post.description ?: '') %}
    {% set content = app.request.isMethod('POST') ? app.request.request.get('content') : post.content %}
    {% set featuredImage = app.request.isMethod('POST') ? app.request.request.get('featured_image') : (post.featuredImage ?: '') %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">CLASS *</label>
                    <select name="class_id" required class="m3-select">
                        <option value="">— Select class —</option>
                        {% for class in classes %}
                            <option value="{{ class.id }}" {% if selectedClass == class.id %}selected{% endif %}>{{ class.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div>
                    <label class="m3-label">AUTHOR *</label>
                    <select name="user_id" required class="m3-select">
                        <option value="">— Select author —</option>
                        {% for user in users %}
                            <option value="{{ user.id }}" {% if selectedUser == user.id %}selected{% endif %}>{{ user.firstName }} {{ user.lastName }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div>
                <label class="m3-label">TITLE *</label>
                <input type="text" name="title" required class="m3-text-field" value="{{ title }}">
            </div>

            <div>
                <label class="m3-label">SUBTITLE</label>
                <input type="text" name="subtitle" class="m3-text-field" value="{{ subtitle }}">
            </div>

            <div>
                <label class="m3-label">DESCRIPTION</label>
                <textarea name="description" rows="3" class="m3-text-field" style="resize: vertical;">{{ description }}</textarea>
            </div>

            <div>
                <label class="m3-label">CONTENT *</label>
                <textarea name="content" required rows="8" class="m3-text-field" style="resize: vertical;">{{ content }}</textarea>
            </div>

            <div>
                <label class="m3-label">FEATURED IMAGE URL</label>
                <input type="text" name="featured_image" class="m3-text-field" value="{{ featuredImage }}">
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
