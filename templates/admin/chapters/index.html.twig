{% extends 'base.html.twig' %}

{% block title %}Chapters — Admin{% endblock %}

{% block body %}
<div style="max-width: 1200px; margin: 0 auto;">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px;">
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Chapter Management</h1>
        <div style="display: flex; gap: 12px;">
            <a href="{{ path('app_dashboard') }}" class="m3-button m3-button-outlined">
                ← Dashboard
            </a>
            <a href="{{ path('admin_chapters_new') }}" class="m3-button m3-button-filled">
                + Add Chapter
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background-color: var(--m3-primary-container); color: var(--m3-on-primary-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            {{ message }}
        </div>
    {% endfor %}

    <div class="m3-card m3-card-outlined" style="padding: 0; overflow: hidden;">
        <table style="width: 100%; border-collapse: collapse; font-size: 0.875rem;">
            <thead style="background-color: var(--m3-surface-container-low);">
                <tr>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">TITLE</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">CLASS</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">SUBJECT</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">ORDER</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">STATUS</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">UPDATED</th>
                    <th style="padding: 16px 24px; text-align: left; color: var(--m3-on-surface-variant); border-bottom: 1px solid var(--m3-outline);">ACTIONS</th>
                </tr>
            </thead>
            <tbody>
            {% for chapter in chapters %}
                <tr style="border-bottom: 1px solid var(--m3-surface-container-high); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='var(--m3-surface-container-low)'" onmouseout="this.style.backgroundColor='transparent'">
                    <td style="padding: 16px 24px; font-weight: 500; color: var(--m3-on-surface);">{{ chapter.title }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ chapter.classe ? chapter.classe.name : '—' }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ chapter.subject ? chapter.subject.name : '—' }}</td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ chapter.sortOrder is not null ? chapter.sortOrder : '—' }}</td>
                    <td style="padding: 16px 24px;">
                        {% if chapter.isPublished %}
                            <span style="color: var(--m3-primary); display: flex; align-items: center; gap: 4px;">● Published</span>
                        {% else %}
                            <span style="color: var(--m3-outline); display: flex; align-items: center; gap: 4px;">○ Draft</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px 24px; color: var(--m3-on-surface-variant);">{{ chapter.updatedAt ? chapter.updatedAt|date('M d, Y H:i') : '—' }}</td>
                    <td style="padding: 16px 24px;">
                        <div style="display: flex; gap: 8px;">
                            <a href="{{ path('admin_chapters_edit', {id: chapter.id}) }}" class="m3-button m3-button-tonal" style="height: 32px; padding: 0 12px;">
                                Edit
                            </a>
                            <form method="post" action="{{ path('admin_chapters_delete', {id: chapter.id}) }}" onsubmit="return confirm('Delete chapter {{ chapter.title }}?');" style="margin: 0;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_chapter_' ~ chapter.id) }}">
                                <button type="submit" class="m3-button" style="height: 32px; padding: 0 12px; background: transparent; border: 1px solid var(--m3-error); color: var(--m3-error);">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" style="padding: 48px; text-align: center; color: var(--m3-outline);">No chapters found.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
