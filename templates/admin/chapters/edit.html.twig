{% extends 'base.html.twig' %}

{% block title %}Edit Chapter — Admin{% endblock %}

{% block body %}
<div style="max-width:640px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;">
    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <a href="{{ path('admin_chapters_index') }}" style="color:#6b7280;text-decoration:none;font-size:.9rem;">← Back to Chapters</a>
        <h1 style="margin:0;font-size:1.5rem;">Edit Chapter #{{ chapter.id }}</h1>
    </div>

    {% if errors is not empty %}
        <div style="background:#fee2e2;color:#b91c1c;padding:.75rem 1rem;border-radius:6px;margin-bottom:1.25rem;">
            <ul style="margin:0;padding-left:1.25rem;">{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul>
        </div>
    {% endif %}

    {% set selectedSection = app.request.isMethod('POST') ? app.request.request.get('subject_section_id') : (chapter.subjectSection ? chapter.subjectSection.id : '') %}
    {% set title = app.request.isMethod('POST') ? app.request.request.get('title') : chapter.title %}
    {% set description = app.request.isMethod('POST') ? app.request.request.get('description') : (chapter.description ?: '') %}
    {% set sortOrder = app.request.isMethod('POST') ? app.request.request.get('sort_order') : (chapter.sortOrder is not null ? chapter.sortOrder : '') %}
    {% set isPublished = app.request.isMethod('POST') ? app.request.request.get('is_published') : chapter.isPublished %}

    <div style="background:#fff;padding:2rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);">
        <form method="post" novalidate>
            <input type="hidden" name="_token" value="{{ csrf_token('chapter_edit_' ~ chapter.id) }}">
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Subject Section</label>
                <select name="subject_section_id" required style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;background:#fff;">
                    <option value="">— Select subject section —</option>
                    {% for section in sections %}
                        <option value="{{ section.id }}" {% if selectedSection == section.id %}selected{% endif %}>
                            #{{ section.id }} — {{ section.classe ? section.classe.name : '—' }} / {{ section.subject ? section.subject.name : '—' }} / {{ section.term ? section.term.name : '—' }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Title</label>
                <input type="text" name="title" required value="{{ title }}" style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Description</label>
                <textarea name="description" rows="4" style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">{{ description }}</textarea>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Sort Order</label>
                <input type="number" name="sort_order" value="{{ sortOrder }}" style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            <div style="margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;">
                <input type="checkbox" name="is_published" id="is_published" value="1" {% if isPublished %}checked{% endif %} style="width:1rem;height:1rem;">
                <label for="is_published" style="font-size:.9rem;font-weight:600;">Published</label>
            </div>

            <button type="submit" style="width:100%;padding:.75rem;background:#2563eb;color:#fff;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;">Save Changes</button>
        </form>
    </div>
</div>
{% endblock %}
