{% extends 'base.html.twig' %}

{% block title %}Edit Term — Admin{% endblock %}

{% block body %}
<div style="max-width:560px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;">

    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <a href="{{ path('admin_terms_index') }}"
           style="color:#6b7280;text-decoration:none;font-size:.9rem;">← Back to Terms</a>
        <h1 style="margin:0;font-size:1.5rem;">Edit Term #{{ term.id }}</h1>
    </div>

    {% if errors is not empty %}
        <div style="background:#fee2e2;color:#b91c1c;padding:.75rem 1rem;border-radius:6px;margin-bottom:1.25rem;">
            <ul style="margin:0;padding-left:1.25rem;">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div style="background:#fff;padding:2rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);">
        <form method="post" novalidate>
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Academic Year</label>
                {% set selectedAcademicYearId = app.request.isMethod('POST') ? app.request.request.get('academic_year_id') : (term.academicYear ? term.academicYear.id : null) %}
                <select name="academic_year_id" required
                        style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
                    <option value="">Select academic year</option>
                    {% for year in academicYears %}
                        <option value="{{ year.id }}" {% if selectedAcademicYearId == year.id %}selected{% endif %}>{{ year.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Term Name</label>
                <input type="text" name="name" required value="{{ app.request.isMethod('POST') ? app.request.request.get('name') : term.name }}"
                       style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Start Date</label>
                <input type="date" name="start_date" required value="{{ app.request.isMethod('POST') ? app.request.request.get('start_date') : (term.startDate ? term.startDate|date('Y-m-d') : '') }}"
                       style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">End Date</label>
                <input type="date" name="end_date" required value="{{ app.request.isMethod('POST') ? app.request.request.get('end_date') : (term.endDate ? term.endDate|date('Y-m-d') : '') }}"
                       style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            {% set isCurrentChecked = app.request.isMethod('POST') ? app.request.request.get('is_current') : term.current %}
            <div style="margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;">
                <input type="checkbox" name="is_current" id="is_current" value="1"
                       {% if isCurrentChecked %}checked{% endif %}
                       style="width:1rem;height:1rem;">
                <label for="is_current" style="font-size:.9rem;font-weight:600;">Current Term</label>
            </div>

            <button type="submit"
                    style="width:100%;padding:.75rem;background:#2563eb;color:#fff;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;">
                Save Changes
            </button>
        </form>
    </div>
</div>
{% endblock %}
