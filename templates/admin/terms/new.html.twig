{% extends 'base.html.twig' %}

{% block title %}Add Term — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_terms_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Add Term</h1>
        <a href="{{ path('admin_academic_years_new', { return_to: app.request.uri }) }}" class="m3-button m3-button-text" style="margin-left: auto; font-size: 0.875rem;">+ Quick add Academic Year</a>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <input type="hidden" name="return_to" value="{{ app.request.query.get('return_to', '') }}">

            <div>
                <label class="m3-label">ACADEMIC YEAR *</label>
                <select name="academic_year_id" required class="m3-select">
                    <option value="">— Select academic year —</option>
                    {% for year in academicYears %}
                        <option value="{{ year.id }}" {% if app.request.get('academic_year_id') == year.id %}selected{% endif %}>{{ year.name }}</option>
                    {% endfor %}
                </select>
            </div>

            <div>
                <label class="m3-label">TERM NAME *</label>
                <input type="text" name="name" required class="m3-text-field" value="{{ app.request.request.get('name', '') }}" placeholder="e.g. Term 1">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">START DATE *</label>
                    <input type="date" name="start_date" required class="m3-text-field" value="{{ app.request.request.get('start_date', '') }}">
                </div>
                <div>
                    <label class="m3-label">END DATE *</label>
                    <input type="date" name="end_date" required class="m3-text-field" value="{{ app.request.request.get('end_date', '') }}">
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="checkbox" name="is_current" id="is_current" value="1" {% if app.request.request.get('is_current') %}checked{% endif %} class="m3-checkbox">
                <label for="is_current" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Current Term</label>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Create Term
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
