{% extends 'base.html.twig' %}

{% block title %}Classes — Admin{% endblock %}

{% block body %}
<div style="max-width:1100px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;">

    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem;">
        <h1 style="margin:0;font-size:1.5rem;">Class Management</h1>
        <div style="display:flex;gap:.75rem;">
            <a href="{{ path('app_dashboard') }}"
               style="padding:.5rem 1rem;background:#6b7280;color:#fff;border-radius:6px;text-decoration:none;font-size:.9rem;">
                ← Dashboard
            </a>
            <a href="{{ path('admin_classes_new') }}"
               style="padding:.5rem 1rem;background:#2563eb;color:#fff;border-radius:6px;text-decoration:none;font-size:.9rem;">
                + Add Class
            </a>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div style="background:#d1fae5;color:#065f46;padding:.75rem 1rem;border-radius:6px;margin-bottom:1rem;">
            {{ message }}
        </div>
    {% endfor %}
    {% for message in app.flashes('error') %}
        <div style="background:#fee2e2;color:#b91c1c;padding:.75rem 1rem;border-radius:6px;margin-bottom:1rem;">
            {{ message }}
        </div>
    {% endfor %}

    <div style="background:#fff;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);overflow:hidden;">
        <table style="width:100%;border-collapse:collapse;font-size:.9rem;">
            <thead style="background:#f9fafb;">
                <tr>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">#</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Name</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Grade</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Section</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Academic Year</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Status</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Created</th>
                    <th style="padding:.75rem 1rem;text-align:left;border-bottom:1px solid #e5e7eb;">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for class in classes %}
                <tr style="border-bottom:1px solid #f3f4f6;">
                    <td style="padding:.75rem 1rem;color:#6b7280;">{{ class.id }}</td>
                    <td style="padding:.75rem 1rem;font-weight:600;">{{ class.name }}</td>
                    <td style="padding:.75rem 1rem;">{{ class.gradeLevel }}</td>
                    <td style="padding:.75rem 1rem;">{{ class.section ?: '—' }}</td>
                    <td style="padding:.75rem 1rem;">{{ class.academicYear ? class.academicYear.name : '—' }}</td>
                    <td style="padding:.75rem 1rem;">
                        {% if class.isActive %}
                            <span style="color:#16a34a;">● Active</span>
                        {% else %}
                            <span style="color:#dc2626;">● Inactive</span>
                        {% endif %}
                    </td>
                    <td style="padding:.75rem 1rem;color:#6b7280;">{{ class.createdAt ? class.createdAt|date('Y-m-d') : '—' }}</td>
                    <td style="padding:.75rem 1rem;">
                        <div style="display:flex;gap:.5rem;">
                            <a href="{{ path('admin_classes_edit', {id: class.id}) }}"
                               style="padding:.3rem .7rem;background:#2563eb;color:#fff;border-radius:5px;text-decoration:none;font-size:.82rem;">
                                Edit
                            </a>
                            <form method="post" action="{{ path('admin_classes_delete', {id: class.id}) }}"
                                  onsubmit="return confirm('Delete class {{ class.name }}?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_class_' ~ class.id) }}">
                                <button type="submit"
                                        style="padding:.3rem .7rem;background:#dc2626;color:#fff;border:none;border-radius:5px;font-size:.82rem;cursor:pointer;">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="8" style="padding:2rem;text-align:center;color:#9ca3af;">No classes found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
