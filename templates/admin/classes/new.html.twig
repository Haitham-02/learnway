{% extends 'base.html.twig' %}

{% block title %}Add Class — Admin{% endblock %}

{% block body %}
<div style="max-width:560px;margin:2rem auto;padding:0 1rem;font-family:sans-serif;">

    <div style="display:flex;align-items:center;gap:1rem;margin-bottom:1.5rem;">
        <a href="{{ path('admin_classes_index') }}"
           style="color:#6b7280;text-decoration:none;font-size:.9rem;">← Back to Classes</a>
        <h1 style="margin:0;font-size:1.5rem;">Add Class</h1>
    </div>

    {% if errors is not empty %}
        <div style="background:#fee2e2;color:#b91c1c;padding:.75rem 1rem;border-radius:6px;margin-bottom:1.25rem;">
            <ul style="margin:0;padding-left:1.25rem;">
                {% for error in errors %}
                    <li>{{ error }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div style="background:#fff;padding:2rem;border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,.1);">
        <form method="post" novalidate>
            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Class Name</label>
                <input type="text" name="name" required value="{{ app.request.request.get('name', '') }}"
                       style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
            </div>

            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                <div>
                    <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Grade Level</label>
                    <input type="text" name="grade_level" required value="{{ app.request.request.get('grade_level', '') }}"
                           style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
                </div>
                <div>
                    <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Section</label>
                    <input type="text" name="section" value="{{ app.request.request.get('section', '') }}"
                           style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;">
                </div>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="display:block;margin-bottom:.4rem;font-size:.9rem;font-weight:600;">Academic Year</label>
                <select name="academic_year_id" required
                        style="width:100%;padding:.6rem .8rem;border:1px solid #d1d5db;border-radius:6px;font-size:1rem;box-sizing:border-box;background:#fff;">
                    <option value="">— Select academic year —</option>
                    {% for academicYear in academicYears %}
                        <option value="{{ academicYear.id }}"
                                {% if app.request.request.get('academic_year_id') == academicYear.id %}selected{% endif %}>
                            {{ academicYear.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>

            <div style="margin-bottom:1.5rem;display:flex;align-items:center;gap:.5rem;">
                <input type="checkbox" name="is_active" id="is_active" value="1"
                       {% if app.request.request.get('is_active', '1') %}checked{% endif %}
                       style="width:1rem;height:1rem;">
                <label for="is_active" style="font-size:.9rem;font-weight:600;">Active</label>
            </div>

            <button type="submit"
                    style="width:100%;padding:.75rem;background:#2563eb;color:#fff;border:none;border-radius:6px;font-size:1rem;font-weight:600;cursor:pointer;">
                Create Class
            </button>
        </form>
    </div>
</div>
{% endblock %}
