{% extends 'base.html.twig' %}

{% block title %}Edit Class — Admin{% endblock %}

{% block body %}
<div style="max-width: 600px; margin: 0 auto;">
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
        <a href="{{ path('admin_classes_index') }}" class="m3-button m3-button-outlined" style="border: none;">
            <span>←</span> Back
        </a>
        <h1 style="margin: 0; font-size: 2rem; font-weight: 400; color: var(--m3-on-surface);">Edit Class</h1>
    </div>

    {% if errors is not empty %}
        <div style="background-color: var(--m3-error-container); color: var(--m3-on-error-container); padding: 16px 24px; border-radius: var(--m3-radius-medium); margin-bottom: 24px;">
            <ul style="margin: 0; padding-left: 20px;">
                {% for error in errors %}<li>{{ error }}</li>{% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="m3-card m3-card-outlined" style="padding: 32px;">
        <form method="post" novalidate style="display: flex; flex-direction: column; gap: 24px;">
            <div>
                <label class="m3-label">CLASS NAME *</label>
                <input type="text" name="name" required class="m3-text-field" value="{{ app.request.isMethod('POST') ? app.request.request.get('name') : class.name }}">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
                <div>
                    <label class="m3-label">GRADE LEVEL *</label>
                    <input type="text" name="grade_level" required class="m3-text-field" value="{{ app.request.isMethod('POST') ? app.request.request.get('grade_level') : class.gradeLevel }}">
                </div>
                <div>
                    <label class="m3-label">SECTION</label>
                    <input type="text" name="section" class="m3-text-field" value="{{ app.request.isMethod('POST') ? app.request.request.get('section') : class.section }}">
                </div>
            </div>

            {% set isActiveChecked = app.request.isMethod('POST') ? app.request.request.get('is_active') : class.isActive %}
            <div style="display: flex; align-items: center; gap: 12px;">
                <input type="checkbox" name="is_active" id="is_active" value="1" {% if isActiveChecked %}checked{% endif %} class="m3-checkbox">
                <label for="is_active" style="font-size: 1rem; color: var(--m3-on-surface); cursor: pointer;">Active</label>
            </div>

            <div style="margin-top: 8px;">
                <button type="submit" class="m3-button m3-button-filled" style="width: 100%; height: 48px;">
                    Save Changes
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
